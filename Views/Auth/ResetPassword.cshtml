@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CookMate</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { margin: 0; padding: 0; background: #E0CEC8; min-height: 100vh; display:flex; align-items:center; justify-content:center; font-family: Inter, sans-serif; }
        .box { background:#fff; border-radius:20px; padding:40px; width:100%; max-width:420px; border:2px solid #090808; box-shadow:0 4px 4px rgba(0,0,0,.25); }
        .title { font-size:24px; font-weight:700; margin:0 0 8px; color:#2c3e50; text-align:center; }
        .subtitle { color:#7f8c8d; text-align:center; margin:0 0 24px; }
        .field { width:100%; padding:12px; border:2px solid #e0e0e0; border-radius:10px; font-size:16px; box-sizing:border-box; margin-bottom:16px; }
        .field:focus { outline:none; border-color:#007bff; }
        .btn { width:100%; padding:12px; background:#007bff; color:#fff; border:none; border-radius:10px; font-size:16px; font-weight:600; cursor:pointer; }
        .btn:hover { background:#0056b3; }
        .error { background:#ffebee; color:#c62828; padding:12px; border-radius:8px; margin-bottom:16px; font-size:14px; }
        .success { background:#e8f5e8; color:#2e7d32; padding:12px; border-radius:8px; margin-bottom:16px; font-size:14px; }
        .back { position:absolute; top:20px; left:20px; background:#fff; border:2px solid #090808; border-radius:20px; padding:8px 16px; text-decoration:none; color:#000; box-shadow:0 4px 4px rgba(0,0,0,.25); }
        .password-strength { margin-top:8px; font-size:12px; }
        .strength-weak { color:#c62828; }
        .strength-medium { color:#f57c00; }
        .strength-strong { color:#2e7d32; }
    </style>
</head>
<body>
    <a class="back" href="@Url.Action("Login","Auth")">← Quay lại</a>
    <div class="box">
        <h1 class="title">Đặt lại mật khẩu</h1>
        <p class="subtitle">Nhập mật khẩu mới cho tài khoản của bạn</p>

        @if (TempData["Error"] != null)
        {
            <div class="error">@TempData["Error"]</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="success">@TempData["Success"]</div>
        }

        <form method="post" action="@Url.Action("ResetPassword","Auth")" id="resetForm">
            <div>
                <input class="field" type="password" name="newPassword" id="newPassword" placeholder="Mật khẩu mới" required />
                <div class="password-strength" id="passwordStrength"></div>
            </div>
            <div>
                <input class="field" type="password" name="confirmPassword" id="confirmPassword" placeholder="Xác nhận mật khẩu" required />
                <div id="passwordMatch" style="margin-top:8px; font-size:12px;"></div>
            </div>
            <button type="submit" class="btn">Đặt lại mật khẩu</button>
        </form>
    </div>

    <script>
        const newPassword = document.getElementById('newPassword');
        const confirmPassword = document.getElementById('confirmPassword');
        const passwordStrength = document.getElementById('passwordStrength');
        const passwordMatch = document.getElementById('passwordMatch');
        const form = document.getElementById('resetForm');

        function checkPasswordStrength(password) {
            let strength = 0;
            let message = '';
            
            if (password.length >= 8) strength++;
            if (/[a-z]/.test(password)) strength++;
            if (/[A-Z]/.test(password)) strength++;
            if (/[0-9]/.test(password)) strength++;
            if (/[^A-Za-z0-9]/.test(password)) strength++;

            if (strength < 2) {
                message = '<span class="strength-weak">Mật khẩu yếu</span>';
            } else if (strength < 4) {
                message = '<span class="strength-medium">Mật khẩu trung bình</span>';
            } else {
                message = '<span class="strength-strong">Mật khẩu mạnh</span>';
            }
            
            passwordStrength.innerHTML = message;
        }

        function checkPasswordMatch() {
            if (confirmPassword.value === '') {
                passwordMatch.innerHTML = '';
                return;
            }
            
            if (newPassword.value === confirmPassword.value) {
                passwordMatch.innerHTML = '<span style="color:#2e7d32;">✓ Mật khẩu khớp</span>';
            } else {
                passwordMatch.innerHTML = '<span style="color:#c62828;">✗ Mật khẩu không khớp</span>';
            }
        }

        newPassword.addEventListener('input', function() {
            checkPasswordStrength(this.value);
            checkPasswordMatch();
        });

        confirmPassword.addEventListener('input', checkPasswordMatch);

        form.addEventListener('submit', function(e) {
            if (newPassword.value !== confirmPassword.value) {
                e.preventDefault();
                alert('Mật khẩu xác nhận không khớp!');
                return false;
            }
            
            if (newPassword.value.length < 6) {
                e.preventDefault();
                alert('Mật khẩu phải có ít nhất 6 ký tự!');
                return false;
            }
        });
    </script>
</body>
</html>
