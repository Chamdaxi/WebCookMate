@model demo.Models.ApplicationUser

@{
    ViewData["Title"] = "Xóa tài khoản";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CookMate</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { 
            margin: 0; 
            padding: 0; 
            background: #E0CEC8; 
            min-height: 100vh; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            font-family: Inter, sans-serif; 
        }
        .box { 
            background: #fff; 
            border-radius: 20px; 
            padding: 40px; 
            width: 100%; 
            max-width: 500px; 
            border: 2px solid #090808; 
            box-shadow: 0 4px 4px rgba(0,0,0,.25); 
        }
        .title { 
            font-size: 24px; 
            font-weight: 700; 
            margin: 0 0 8px; 
            color: #c62828; 
            text-align: center; 
        }
        .subtitle { 
            color: #7f8c8d; 
            text-align: center; 
            margin: 0 0 24px; 
        }
        .warning-box {
            background: #fff3cd;
            border: 2px solid #ffc107;
            border-radius: 10px;
            padding: 16px;
            margin-bottom: 24px;
        }
        .warning-box h3 {
            margin: 0 0 8px 0;
            color: #856404;
            font-size: 16px;
        }
        .warning-box ul {
            margin: 8px 0 0 0;
            padding-left: 20px;
            color: #856404;
            font-size: 14px;
        }
        .warning-box li {
            margin-bottom: 4px;
        }
        .user-info {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 16px;
            margin-bottom: 24px;
        }
        .user-info-label {
            font-weight: 600;
            color: #495057;
            margin-bottom: 4px;
        }
        .user-info-value {
            color: #212529;
        }
        .field { 
            width: 100%; 
            padding: 12px; 
            border: 2px solid #e0e0e0; 
            border-radius: 10px; 
            font-size: 16px; 
            box-sizing: border-box; 
            margin-bottom: 16px; 
        }
        .field:focus { 
            outline: none; 
            border-color: #c62828; 
        }
        .btn { 
            width: 100%; 
            padding: 12px; 
            background: #c62828; 
            color: #fff; 
            border: none; 
            border-radius: 10px; 
            font-size: 16px; 
            font-weight: 600; 
            cursor: pointer; 
            margin-bottom: 12px;
        }
        .btn:hover { 
            background: #b71c1c; 
        }
        .btn-secondary {
            background: #6c757d;
        }
        .btn-secondary:hover {
            background: #5a6268;
        }
        .error { 
            background: #ffebee; 
            color: #c62828; 
            padding: 12px; 
            border-radius: 8px; 
            margin-bottom: 16px; 
            font-size: 14px; 
        }
        .back { 
            position: absolute; 
            top: 20px; 
            left: 20px; 
            background: #fff; 
            border: 2px solid #090808; 
            border-radius: 20px; 
            padding: 8px 16px; 
            text-decoration: none; 
            color: #000; 
            box-shadow: 0 4px 4px rgba(0,0,0,.25); 
        }
    </style>
</head>
<body>
    <a class="back" href="@Url.Action("UserProfile", "Auth")">← Quay lại</a>
    <div class="box">
        <h1 class="title">⚠️ Xóa tài khoản</h1>
        <p class="subtitle">Hành động này không thể hoàn tác</p>

        @if (TempData["Error"] != null)
        {
            <div class="error">@TempData["Error"]</div>
        }

        <div class="warning-box">
            <h3>⚠️ Cảnh báo quan trọng:</h3>
            <ul>
                <li>Tất cả dữ liệu của bạn sẽ bị xóa vĩnh viễn</li>
                <li>Bạn sẽ không thể khôi phục tài khoản sau khi xóa</li>
                <li>Tất cả công thức nấu ăn, danh sách mua sắm và dữ liệu khác sẽ bị mất</li>
                <li>Bạn cần tạo tài khoản mới nếu muốn sử dụng lại dịch vụ</li>
            </ul>
        </div>

        <div class="user-info">
            <div class="user-info-label">Tài khoản sẽ bị xóa:</div>
            <div class="user-info-value">@Model.Email</div>
            @if (!string.IsNullOrEmpty(Model.FullName))
            {
                <div class="user-info-label" style="margin-top: 8px;">Họ tên:</div>
                <div class="user-info-value">@Model.FullName</div>
            }
        </div>

        <form method="post" action="@Url.Action("ConfirmDeleteAccount", "Auth")" id="deleteForm">
            @Html.AntiForgeryToken()
            
            <div>
                <label for="password" style="display: block; margin-bottom: 8px; font-weight: 600; color: #495057;">
                    Nhập mật khẩu để xác nhận:
                </label>
                <input class="field" type="password" name="password" id="password" placeholder="Mật khẩu của bạn" />
                <small style="color: #6c757d; font-size: 12px;">
                    Nếu bạn đăng nhập bằng Google/OTP và không có mật khẩu, để trống trường này.
                </small>
            </div>
            
            <button type="submit" class="btn" onclick="return confirm('Bạn CHẮC CHẮN muốn xóa tài khoản này? Hành động này KHÔNG THỂ hoàn tác!');">
                Xác nhận xóa tài khoản
            </button>
            
            <a href="@Url.Action("UserProfile", "Auth")" class="btn btn-secondary" style="text-decoration: none; display: block; text-align: center;">
                Hủy bỏ
            </a>
        </form>
    </div>
</body>
</html>
