@{
    ViewData["Title"] = "Khôi phục tài khoản";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CookMate</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { margin: 0; padding: 0; background: #E0CEC8; min-height: 100vh; display:flex; align-items:center; justify-content:center; font-family: Inter, sans-serif; }
        .box { background:#fff; border-radius:20px; padding:40px; width:100%; max-width:420px; border:2px solid #090808; box-shadow:0 4px 4px rgba(0,0,0,.25); }
        .title { font-size:24px; font-weight:700; margin:0 0 8px; color:#2c3e50; text-align:center; }
        .subtitle { color:#7f8c8d; text-align:center; margin:0 0 24px; }
        .field { width:100%; padding:12px; border:2px solid #e0e0e0; border-radius:10px; font-size:16px; box-sizing:border-box; }
        .btn { width:100%; padding:12px; background:#007bff; color:#fff; border:none; border-radius:10px; font-size:16px; font-weight:600; cursor:pointer; }
        .btn:hover { background:#0056b3; }
        .error { background:#ffebee; color:#c62828; padding:12px; border-radius:8px; margin-bottom:16px; font-size:14px; }
        .success { background:#e8f5e8; color:#2e7d32; padding:12px; border-radius:8px; margin-bottom:16px; font-size:14px; }
        .back { position:absolute; top:20px; left:20px; background:#fff; border:2px solid #090808; border-radius:20px; padding:8px 16px; text-decoration:none; color:#000; box-shadow:0 4px 4px rgba(0,0,0,.25); }
    </style>
</head>
<body>
    <a class="back" href="@Url.Action("Login","Auth")">← Quay lại</a>
    <div class="box">
        <h1 class="title">Khôi phục tài khoản</h1>
        <p class="subtitle">Nhập email để nhận mã OTP khôi phục</p>

        @if (TempData["Error"] != null)
        {
            <div class="error">@TempData["Error"]</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="success">@TempData["Success"]</div>
        }

        <form method="post" action="@Url.Action("ForgotPassword","Auth")">
            <div style="margin-bottom:16px;">
                <input class="field" type="email" name="email" placeholder="Email của bạn" required />
            </div>
            <button type="submit" class="btn">Gửi mã OTP</button>
        </form>
    </div>
</body>
</html>



