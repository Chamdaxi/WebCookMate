@{
    ViewData["Title"] = "Đăng nhập OTP";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>@ViewData["Title"] - CookMate</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            margin: 0;
        }
        
        .container {
            background: white;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 450px;
            text-align: center;
        }
        
        .logo {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            margin: 0 auto 20px;
            background: #667eea;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 24px;
            font-weight: bold;
            overflow: hidden;
        }
        
        .logo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
        }
        
        h1 {
            color: #333;
            margin-bottom: 10px;
            font-size: 28px;
        }
        
        .subtitle {
            color: #666;
            margin-bottom: 30px;
            font-size: 16px;
        }
        
        .demo-notice {
            background: #fbbf24;
            color: white;
            padding: 10px 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 14px;
            font-weight: 500;
        }
        
        .form-group {
            margin-bottom: 20px;
            text-align: left;
        }
        
        label {
            display: block;
            margin-bottom: 8px;
            color: #333;
            font-weight: 500;
        }
        
        input {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            font-size: 16px;
            transition: border-color 0.3s;
            box-sizing: border-box;
        }
        
        input:focus {
            outline: none;
            border-color: #667eea;
        }
        
        .btn {
            width: 100%;
            padding: 15px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.3s;
        }
        
        .btn:hover {
            transform: translateY(-2px);
        }
        
        .btn:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none;
        }
        
        .message {
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 20px;
            font-weight: 500;
        }
        
        .success {
            background: #48bb78;
            color: white;
        }
        
        .error {
            background: #f56565;
            color: white;
        }
        
        .step {
            display: none;
        }
        
        .step.active {
            display: block;
        }
        
        .back-link {
            color: #667eea;
            text-decoration: none;
            font-size: 14px;
            margin-top: 20px;
            display: inline-block;
        }
        
        .back-link:hover {
            text-decoration: underline;
        }
        
        .phone-info {
            background: #e6f3ff;
            color: #0066cc;
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="logo">
            <img src="~/images/logos/LogoCook.jpg" alt="CookMate Logo" onerror="this.style.display='none'; this.parentElement.innerHTML='🍳';">
        </div>
        <h1>Đăng nhập OTP</h1>
        <p class="subtitle">Nhập email để nhận mã OTP</p>
        
        <div class="demo-notice" style="display: none;">
            <strong>Demo Mode:</strong> OTP sẽ hiển thị trực tiếp trên màn hình
        </div>

        <div class="phone-info">
            📧 <strong>Thông báo:</strong> Mã OTP sẽ được gửi đến email của bạn
        </div>

        <!-- Bước 1: Nhập Email và Số điện thoại -->
        <div id="step1" class="step active">
            <form id="emailForm">
                <div class="form-group">
                    <label for="email">Email:</label>
                    <input type="email" id="email" name="email" placeholder="Nhập email của bạn" required>
                </div>
                <button type="submit" class="btn">Gửi mã OTP</button>
            </form>
        </div>

        <!-- Bước 2: Nhập OTP -->
        <div id="step2" class="step">
            <form id="otpForm">
                <div class="form-group">
                    <label for="otp">Mã OTP:</label>
                    <input type="text" id="otp" name="otp" placeholder="Nhập mã OTP" maxlength="6" required>
                </div>
                <button type="submit" class="btn">Xác thực OTP</button>
            </form>
        </div>

        <a href="@Url.Action("Login", "Auth")" class="back-link">← Quay lại đăng nhập</a>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const emailForm = document.getElementById('emailForm');
            const otpForm = document.getElementById('otpForm');
            const step1 = document.getElementById('step1');
            const step2 = document.getElementById('step2');

            // Gửi OTP
            emailForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                const email = document.getElementById('email').value;
                const btn = this.querySelector('button');
                const originalText = btn.textContent;
                
                btn.textContent = 'Đang gửi...';
                btn.disabled = true;

                console.log('Sending OTP to:', email);

                const formData = new FormData();
                formData.append('email', email);

                fetch('/Auth/SendOTP', {
                    method: 'POST',
                    body: formData
                })
                .then(response => {
                    console.log('Response status:', response.status);
                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }
                    return response.text();
                })
                .then(text => {
                    console.log('Response text:', text);
                    try {
                        const data = JSON.parse(text);
                        console.log('Parsed data:', data);
                        if (data.success) {
                            showMessage(data.message, 'success');
                            step1.classList.remove('active');
                            step2.classList.add('active');
                        } else {
                            showMessage(data.message || 'Có lỗi xảy ra!', 'error');
                        }
                    } catch (parseError) {
                        console.error('JSON parse error:', parseError);
                        showMessage('Lỗi định dạng response: ' + text, 'error');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showMessage('Có lỗi xảy ra khi gửi OTP: ' + error.message, 'error');
                })
                .finally(() => {
                    btn.textContent = originalText;
                    btn.disabled = false;
                });
            });

            // Xác thực OTP
            otpForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                const otp = document.getElementById('otp').value;
                const btn = this.querySelector('button');
                const originalText = btn.textContent;
                
                btn.textContent = 'Đang xác thực...';
                btn.disabled = true;

                console.log('Verifying OTP:', otp);

                const formData = new FormData();
                formData.append('otpCode', otp);

                fetch('/Auth/VerifyOTP', {
                    method: 'POST',
                    body: formData
                })
                .then(response => {
                    console.log('Verify response status:', response.status);
                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }
                    return response.text();
                })
                .then(text => {
                    console.log('Verify response text:', text);
                    try {
                        const data = JSON.parse(text);
                        console.log('Verify parsed data:', data);
                        if (data.success) {
                            showMessage('Đăng nhập thành công!', 'success');
                            setTimeout(() => {
                                window.location.href = data.redirectUrl || '/';
                            }, 1000);
                        } else {
                            showMessage(data.message || 'Mã OTP không đúng!', 'error');
                        }
                    } catch (parseError) {
                        console.error('JSON parse error:', parseError);
                        showMessage('Lỗi định dạng response: ' + text, 'error');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showMessage('Có lỗi xảy ra khi xác thực OTP: ' + error.message, 'error');
                })
                .finally(() => {
                    btn.textContent = originalText;
                    btn.disabled = false;
                });
            });

            // Auto-format OTP input
            document.getElementById('otp').addEventListener('input', function(e) {
                this.value = this.value.replace(/\D/g, '').substring(0, 6);
            });

            function showMessage(message, type) {
                // Remove existing messages
                const existingMessages = document.querySelectorAll('.message');
                existingMessages.forEach(msg => msg.remove());

                // Create new message
                const messageDiv = document.createElement('div');
                messageDiv.className = 'message ' + type;
                messageDiv.textContent = message;
                
                // Insert after demo notice
                const demoNotice = document.querySelector('.demo-notice');
                demoNotice.insertAdjacentElement('afterend', messageDiv);

                // Auto remove after 5 seconds
                setTimeout(() => {
                    messageDiv.remove();
                }, 5000);
            }
        });
    </script>
</body>
</html>
