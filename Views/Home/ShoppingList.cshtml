@model IEnumerable<demo.Models.ShoppingItem>
@{
    ViewData["Title"] = "Shopping List";
    Layout = "_Layout";
    var shoppingItems = ViewBag.ShoppingItems as List<demo.Models.ShoppingItem> ?? new List<demo.Models.ShoppingItem>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/shoppinglist.css" asp-append-version="true" />
    <style>
        /* Modal Styles */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0,0,0,0.5);
        }
        
        .modal-content {
            background-color: #fff;
            margin: 5% auto;
            padding: 40px;
            border: none;
            border-radius: 24px;
            width: 90%;
            max-width: 800px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }
        
        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        
        .modal-header h3 {
            margin: 0;
            font-size: 24px;
            font-weight: 600;
        }
        
        .close {
            color: #aaa;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
            border: none;
            background: none;
        }
        
        .close:hover {
            color: #000;
        }
        
        .recipe-search-section {
            margin-bottom: 20px;
        }
        
        .recipe-search-input {
            width: 100%;
            padding: 12px;
            border: 2px solid #090808;
            border-radius: 8px;
            font-size: 16px;
            margin-bottom: 15px;
        }
        
        .recipe-results {
            max-height: 400px;
            overflow-y: auto;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 15px;
        }
        
        .recipe-card {
            border: none;
            border-radius: 16px;
            padding: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
            background: white;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }
        
        .recipe-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        }
        
        .recipe-card img {
            width: 100%;
            height: 150px;
            object-fit: cover;
            border-radius: 8px;
            margin-bottom: 10px;
        }
        
        .recipe-card h4 {
            margin: 0 0 5px 0;
            font-size: 18px;
            font-weight: 600;
        }
        
        .recipe-card p {
            margin: 0 0 10px 0;
            color: #666;
            font-size: 14px;
        }
        
        .recipe-ingredients {
            font-size: 12px;
            color: #888;
        }
        
        .add-to-cart-btn {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 10px 20px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            margin-top: 10px;
            box-shadow: 0 4px 15px rgba(17, 153, 142, 0.4);
            transition: all 0.3s ease;
        }
        
        .add-to-cart-btn:hover {
            background: linear-gradient(135deg, #38ef7d 0%, #11998e 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(17, 153, 142, 0.6);
        }
        
        .cart-btn {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 12px 20px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            box-shadow: 0 4px 15px rgba(17, 153, 142, 0.4);
            transition: all 0.3s ease;
        }
        
        .cart-btn:hover {
            background: linear-gradient(135deg, #38ef7d 0%, #11998e 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(17, 153, 142, 0.6);
        }
        
        .empty-state {
            text-align: center;
            padding: 40px;
            color: #666;
        }
        
        .empty-state svg {
            width: 80px;
            height: 80px;
            margin-bottom: 20px;
            opacity: 0.5;
        }
    </style>
}

<!-- Main Content -->
<div class="shoppinglist-page">
    <div class="shoppinglist-content">
        <!-- Header Section -->
        <div class="shoppinglist-header">
            <h2 class="shoppinglist-title">Shopping List</h2>
            <div class="header-actions">
                <div class="search-filter-section">
                    <input type="text" id="searchInput" placeholder="Tìm kiếm items..." class="search-input">
                    <select id="categoryFilter" class="category-filter">
                        <option value="">Tất cả danh mục</option>
                        <option value="meat">Thịt & Cá</option>
                        <option value="vegetables">Rau củ</option>
                        <option value="grains">Ngũ cốc</option>
                        <option value="dairy">Sữa & Trứng</option>
                        <option value="spices">Gia vị</option>
                        <option value="other">Khác</option>
                    </select>
                    <button class="add-item-btn" onclick="openRecipeSearchModal()" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); box-shadow: 0 4px 15px rgba(245, 87, 108, 0.4);">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <path d="M21 21l-4.35-4.35"></path>
                        </svg>
                        Tìm món ăn
                    </button>
                </div>
                <div style="display: flex; gap: 10px;">
                    <button class="add-item-btn" onclick="addNewItem()">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        Add Item
                    </button>
                    <a href="@Url.Action("Cart", "Home")" class="cart-btn">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 18px; height: 18px;">
                            <circle cx="9" cy="21" r="1"></circle>
                            <circle cx="20" cy="21" r="1"></circle>
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                        </svg>
                        Giỏ hàng
                    </a>
                </div>
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="quick-stats">
            <div class="stat-item">
                <span class="stat-number" id="totalItems">0</span>
                <span class="stat-label">Tổng items</span>
            </div>
            <div class="stat-item">
                <span class="stat-number" id="completedItems">0</span>
                <span class="stat-label">Đã hoàn thành</span>
            </div>
            <div class="stat-item">
                <span class="stat-number" id="remainingItems">0</span>
                <span class="stat-label">Còn lại</span>
            </div>
        </div>

        <!-- Shopping Items -->
        <div class="shopping-items" id="shoppingItemsContainer">
            @if (shoppingItems.Any())
            {
                @foreach (var item in shoppingItems)
                {
                    <div class="shopping-item" data-item-id="@item.Id" data-category="@(item.Category?.ToLower() ?? "")">
                        <div class="item-checkbox">
                            <input type="checkbox" id="item@(item.Id)" class="checkbox-input" @(item.IsCompleted ? "checked" : "")>
                            <label for="item@(item.Id)" class="checkbox-label"></label>
                        </div>
                        <div class="item-content">
                            <div class="item-info">
                                <h5 class="item-name">@item.Name</h5>
                                @if (!string.IsNullOrEmpty(item.Category))
                                {
                                    <span class="item-category">@item.Category</span>
                                }
                                @if (!string.IsNullOrEmpty(item.Notes))
                                {
                                    <p class="item-notes">@item.Notes</p>
                                }
                                @if (item.Quantity > 0)
                                {
                                    <p style="font-size: 12px; color: #666; margin: 5px 0 0 0;">
                                        Số lượng: @item.Quantity @(item.Unit ?? "")
                                    </p>
                                }
                                @if (item.Price.HasValue)
                                {
                                    <p style="font-size: 18px; color: #11998e; font-weight: 700; margin: 8px 0 0 0; background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                                        @((item.Price.Value * item.Quantity).ToString("N0")) đ
                                    </p>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <div class="item-image">
                                    <img src="@item.ImageUrl" alt="@item.Name">
                                </div>
                            }
                        </div>
                        <div class="item-actions">
                            @if (!item.InCart)
                            {
                                <button class="action-btn add-cart" onclick="addToCart(@item.Id, '@item.Name', '@item.Category', @item.Quantity, '@(item.Unit ?? "")', @(item.Price.HasValue ? item.Price.Value.ToString() : "null"))" title="Thêm vào giỏ hàng">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="9" cy="21" r="1"></circle>
                                        <circle cx="20" cy="21" r="1"></circle>
                                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                    </svg>
                                </button>
                            }
                            <button class="action-btn notes" onclick="toggleNotes(@item.Id)" title="Ghi chú">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14,2 14,8 20,8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                </svg>
                            </button>
                            <button class="action-btn edit" onclick="editItem(@item.Id)" title="Sửa">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                </svg>
                            </button>
                            <button class="action-btn delete" onclick="deleteItem(@item.Id)" title="Xóa">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="3,6 5,6 21,6"></polyline>
                                    <path d="M19,6v14a2,2 0 0,1 -2,2H7a2,2 0 0,1 -2,-2V6m3,0V4a2,2 0 0,1 2,-2h4a2,2 0 0,1 2,2v2"></path>
                                    <line x1="10" y1="11" x2="10" y2="17"></line>
                                    <line x1="14" y1="11" x2="14" y2="17"></line>
                                </svg>
                            </button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                        <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                        <line x1="12" y1="11" x2="12" y2="17"></line>
                        <line x1="9" y1="14" x2="15" y2="14"></line>
                    </svg>
                    <h3>Chưa có items nào</h3>
                    <p>Thêm items mới hoặc tìm kiếm món ăn để bắt đầu!</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Recipe Search Modal -->
<div id="recipeSearchModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Tìm kiếm món ăn</h3>
            <button class="close" onclick="closeRecipeSearchModal()">&times;</button>
        </div>
        <div class="recipe-search-section">
            <input type="text" id="recipeSearchInput" class="recipe-search-input" placeholder="Nhập tên món ăn hoặc nguyên liệu..." onkeypress="if(event.key === 'Enter') searchRecipes()">
            <button class="add-item-btn" onclick="searchRecipes()" style="width: 100%;">Tìm kiếm</button>
        </div>
        <div id="recipeResults" class="recipe-results"></div>
    </div>
</div>

@section Scripts {
    <script>
        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            updateStats();
            
            // Checkbox functionality
            const checkboxes = document.querySelectorAll('.checkbox-input');
            checkboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    const itemId = this.closest('.shopping-item').getAttribute('data-item-id');
                    const isCompleted = this.checked;
                    updateItemStatus(itemId, isCompleted);
                });
            });

            // Search functionality
            const searchInput = document.getElementById('searchInput');
            searchInput.addEventListener('input', filterItems);

            // Category filter functionality
            const categoryFilter = document.getElementById('categoryFilter');
            categoryFilter.addEventListener('change', filterItems);
        });

        // Update statistics
        function updateStats() {
            const totalItems = document.querySelectorAll('.shopping-item').length;
            const completedItems = document.querySelectorAll('.shopping-item .checkbox-input:checked').length;
            const remainingItems = totalItems - completedItems;

            document.getElementById('totalItems').textContent = totalItems;
            document.getElementById('completedItems').textContent = completedItems;
            document.getElementById('remainingItems').textContent = remainingItems;
        }

        // Filter items
        function filterItems() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const selectedCategory = document.getElementById('categoryFilter').value.toLowerCase();
            const items = document.querySelectorAll('.shopping-item');

            items.forEach(item => {
                const itemName = item.querySelector('.item-name').textContent.toLowerCase();
                const itemCategory = item.getAttribute('data-category') || '';
                
                const matchesSearch = itemName.includes(searchTerm);
                const matchesCategory = !selectedCategory || itemCategory === selectedCategory;
                
                item.style.display = (matchesSearch && matchesCategory) ? 'flex' : 'none';
            });
        }

        // Open Recipe Search Modal
        function openRecipeSearchModal() {
            document.getElementById('recipeSearchModal').style.display = 'block';
        }

        // Close Recipe Search Modal
        function closeRecipeSearchModal() {
            document.getElementById('recipeSearchModal').style.display = 'none';
            document.getElementById('recipeResults').innerHTML = '';
            document.getElementById('recipeSearchInput').value = '';
        }

        // Close modal when clicking outside
        window.onclick = function(event) {
            const modal = document.getElementById('recipeSearchModal');
            if (event.target == modal) {
                closeRecipeSearchModal();
            }
        }

        // Search Recipes
        async function searchRecipes() {
            const query = document.getElementById('recipeSearchInput').value.trim();
            if (!query) {
                alert('Vui lòng nhập từ khóa tìm kiếm');
                return;
            }

            const resultsDiv = document.getElementById('recipeResults');
            resultsDiv.innerHTML = '<p>Đang tìm kiếm...</p>';

            try {
                const response = await fetch('@Url.Action("SearchRecipes", "Home")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: 'query=' + encodeURIComponent(query)
                });

                const data = await response.json();
                
                if (data.success && data.recipes && data.recipes.length > 0) {
                    resultsDiv.innerHTML = '';
                    data.recipes.forEach(recipe => {
                        const recipeCard = document.createElement('div');
                        recipeCard.className = 'recipe-card';
                        recipeCard.innerHTML = `
                            ${recipe.imageUrl ? `<img src="${recipe.imageUrl}" alt="${recipe.name}">` : ''}
                            <h4>${recipe.name}</h4>
                            <p>${recipe.description || ''}</p>
                            <div class="recipe-ingredients">
                                <strong>Nguyên liệu:</strong> ${recipe.ingredients ? recipe.ingredients.join(', ') : ''}
                            </div>
                            <button class="add-to-cart-btn" onclick="addRecipeIngredientsToCart(${recipe.id}, '${recipe.name.replace(/'/g, "\\'")}', ${JSON.stringify(recipe.ingredients || [])})">
                                Thêm nguyên liệu vào giỏ hàng
                            </button>
                        `;
                        resultsDiv.appendChild(recipeCard);
                    });
                } else {
                    resultsDiv.innerHTML = '<p>Không tìm thấy món ăn nào</p>';
                }
            } catch (error) {
                console.error('Error searching recipes:', error);
                resultsDiv.innerHTML = '<p>Có lỗi xảy ra khi tìm kiếm</p>';
            }
        }

        // Add Recipe Ingredients to Cart
        async function addRecipeIngredientsToCart(recipeId, recipeName, ingredients) {
            if (!ingredients || ingredients.length === 0) {
                alert('Món ăn này không có nguyên liệu');
                return;
            }

            if (!confirm(`Thêm tất cả nguyên liệu của "${recipeName}" vào giỏ hàng?`)) {
                return;
            }

            try {
                for (const ingredient of ingredients) {
                    await fetch('@Url.Action("AddToCart", "Home")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: `name=${encodeURIComponent(ingredient)}&category=other&quantity=1`
                    });
                }
                alert(`Đã thêm ${ingredients.length} nguyên liệu vào giỏ hàng!`);
                closeRecipeSearchModal();
            } catch (error) {
                console.error('Error adding to cart:', error);
                alert('Có lỗi xảy ra khi thêm vào giỏ hàng');
            }
        }

        // Add New Item
        async function addNewItem() {
            const name = prompt('Tên item:');
            if (!name || !name.trim()) return;

            const category = prompt('Danh mục (meat, vegetables, grains, dairy, spices, other):') || 'other';
            const notes = prompt('Ghi chú (tùy chọn):') || '';
            const quantity = parseInt(prompt('Số lượng:') || '1');
            const unit = prompt('Đơn vị (kg, g, l, pcs, ...):') || '';
            const priceInput = prompt('Giá tiền (VND, tùy chọn):') || '';
            const price = priceInput ? parseFloat(priceInput) : null;

            try {
                const response = await fetch('@Url.Action("AddToShoppingList", "Home")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `name=${encodeURIComponent(name)}&category=${encodeURIComponent(category)}&notes=${encodeURIComponent(notes)}&quantity=${quantity}&unit=${encodeURIComponent(unit)}${price ? '&price=' + price : ''}`
                });

                const data = await response.json();
                if (data.success) {
                    location.reload();
                } else {
                    alert('Có lỗi xảy ra: ' + (data.message || ''));
                }
            } catch (error) {
                console.error('Error adding item:', error);
                alert('Có lỗi xảy ra khi thêm item');
            }
        }

        // Edit Item
        async function editItem(itemId) {
            const item = document.querySelector(`[data-item-id="${itemId}"]`);
            if (!item) return;

            const currentName = item.querySelector('.item-name').textContent;
            const currentCategory = item.querySelector('.item-category')?.textContent || '';
            const currentNotes = item.querySelector('.item-notes')?.textContent || '';

            const newName = prompt('Tên mới:', currentName);
            if (!newName || newName.trim() === currentName) return;

            const newCategory = prompt('Danh mục mới:', currentCategory) || currentCategory;
            const newNotes = prompt('Ghi chú mới:', currentNotes) || '';

            try {
                const response = await fetch('@Url.Action("UpdateShoppingItem", "Home")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `id=${itemId}&name=${encodeURIComponent(newName)}&category=${encodeURIComponent(newCategory)}&notes=${encodeURIComponent(newNotes)}`
                });

                const data = await response.json();
                if (data.success) {
                    location.reload();
                } else {
                    alert('Có lỗi xảy ra: ' + (data.message || ''));
                }
            } catch (error) {
                console.error('Error updating item:', error);
                alert('Có lỗi xảy ra khi cập nhật item');
            }
        }

        // Delete Item
        async function deleteItem(itemId) {
            if (!confirm('Bạn có chắc muốn xóa item này?')) return;

            try {
                const response = await fetch('@Url.Action("DeleteShoppingItem", "Home")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `id=${itemId}`
                });

                const data = await response.json();
                if (data.success) {
                    document.querySelector(`[data-item-id="${itemId}"]`).remove();
                    updateStats();
                } else {
                    alert('Có lỗi xảy ra: ' + (data.message || ''));
                }
            } catch (error) {
                console.error('Error deleting item:', error);
                alert('Có lỗi xảy ra khi xóa item');
            }
        }

        // Toggle Notes
        async function toggleNotes(itemId) {
            const item = document.querySelector(`[data-item-id="${itemId}"]`);
            if (!item) return;

            const currentNotes = item.querySelector('.item-notes')?.textContent || '';
            const newNotes = prompt('Chỉnh sửa ghi chú:', currentNotes);
            
            if (newNotes === null) return;

            try {
                const response = await fetch('@Url.Action("UpdateShoppingItem", "Home")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `id=${itemId}&notes=${encodeURIComponent(newNotes)}`
                });

                const data = await response.json();
                if (data.success) {
                    location.reload();
                } else {
                    alert('Có lỗi xảy ra: ' + (data.message || ''));
                }
            } catch (error) {
                console.error('Error updating notes:', error);
                alert('Có lỗi xảy ra khi cập nhật ghi chú');
            }
        }

        // Update Item Status
        async function updateItemStatus(itemId, isCompleted) {
            try {
                await fetch('@Url.Action("UpdateShoppingItem", "Home")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `id=${itemId}&isCompleted=${isCompleted}`
                });
                updateStats();
            } catch (error) {
                console.error('Error updating status:', error);
            }
        }

        // Add to Cart
        async function addToCart(itemId, name, category, quantity, unit, price) {
            try {
                const bodyParams = `shoppingItemId=${itemId}&name=${encodeURIComponent(name)}&category=${encodeURIComponent(category || '')}&quantity=${quantity}&unit=${encodeURIComponent(unit || '')}`;
                const finalBody = price && price !== 'null' ? bodyParams + `&price=${price}` : bodyParams;
                
                const response = await fetch('@Url.Action("AddToCart", "Home")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: finalBody
                });

                const data = await response.json();
                if (data.success) {
                    alert('Đã thêm vào giỏ hàng!');
                    location.reload();
                } else {
                    alert('Có lỗi xảy ra: ' + (data.message || ''));
                }
            } catch (error) {
                console.error('Error adding to cart:', error);
                alert('Có lỗi xảy ra khi thêm vào giỏ hàng');
            }
        }
    </script>
}
