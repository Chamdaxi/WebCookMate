@{
    ViewData["Title"] = "Shopping List";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/shoppinglist.css" asp-append-version="true" />
}

<!-- Main Content -->
<div class="shoppinglist-page">
    <div class="shoppinglist-content">
        <!-- Header Section -->
        <div class="shoppinglist-header">
            <h2 class="shoppinglist-title">Shopping List</h2>
            <div class="header-actions">
                <div class="search-filter-section">
                    <input type="text" id="searchInput" placeholder="Tìm kiếm items..." class="search-input">
                    <select id="categoryFilter" class="category-filter">
                        <option value="">Tất cả danh mục</option>
                        <option value="meat">Thịt & Cá</option>
                        <option value="vegetables">Rau củ</option>
                        <option value="grains">Ngũ cốc</option>
                        <option value="dairy">Sữa & Trứng</option>
                        <option value="spices">Gia vị</option>
                        <option value="other">Khác</option>
                    </select>
                </div>
                <button class="add-item-btn" onclick="addNewItem()">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Add Item
                </button>
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="quick-stats">
            <div class="stat-item">
                <span class="stat-number" id="totalItems">3</span>
                <span class="stat-label">Tổng items</span>
            </div>
            <div class="stat-item">
                <span class="stat-number" id="completedItems">0</span>
                <span class="stat-label">Đã hoàn thành</span>
            </div>
            <div class="stat-item">
                <span class="stat-number" id="remainingItems">3</span>
                <span class="stat-label">Còn lại</span>
            </div>
        </div>

        <!-- Shopping Items -->
        <div class="shopping-items" id="shoppingItems">
            <!-- Items will be loaded from API -->
        </div>

        <!-- Empty State (hidden by default) -->
        <div class="empty-state" id="emptyState" style="display: none; text-align: center; padding: 40px;">
            <p style="color: #999; font-size: 16px;">Chưa có item nào trong danh sách mua sắm</p>
            <button class="add-item-btn" onclick="addNewItem()" style="margin-top: 20px;">
                Thêm item đầu tiên
            </button>
        </div>


        <!-- Pagination -->
        <div class="pagination">
            <button class="pagination-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15,18 9,12 15,6"></polyline>
                </svg>
            </button>
            <button class="pagination-btn active">1</button>
            <button class="pagination-btn">2</button>
            <button class="pagination-btn">3</button>
            <button class="pagination-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9,18 15,12 9,6"></polyline>
                </svg>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let shoppingItems = [];
        let editingItemId = null;

        // Load shopping items from API
        async function loadShoppingItems() {
            try {
                const response = await fetch('/api/ShoppingListApi', {
                    credentials: 'include'
                });

                if (response.ok) {
                    shoppingItems = await response.json();
                    console.log('✅ Loaded ' + shoppingItems.length + ' shopping items from CookMate API');
                    renderItems();
                    updateStats();
                } else {
                    console.error('Failed to load shopping items');
                    showEmptyState();
                }
            } catch (error) {
                console.error('Error loading shopping items:', error);
                showEmptyState();
            }
        }

        // Render shopping items
        function renderItems() {
            const container = document.getElementById('shoppingItems');
            
            if (!shoppingItems || shoppingItems.length === 0) {
                showEmptyState();
                return;
            }

            document.getElementById('emptyState').style.display = 'none';
            
            container.innerHTML = shoppingItems.map((item, index) => {
                const isCompleted = item.status === 'completed' || item.status === 'draft';
                const itemId = item.id || item._id || `item_${index}`;
                
                return `
                    <div class="shopping-item ${isCompleted ? 'completed' : ''}" data-item-id="${itemId}" data-category="${getCategoryFromName(item.name)}">
                        <div class="item-checkbox">
                            <input type="checkbox" id="checkbox_${itemId}" class="checkbox-input" ${isCompleted ? 'checked' : ''} onchange="toggleItemStatus('${itemId}')">
                            <label for="checkbox_${itemId}" class="checkbox-label"></label>
                        </div>
                        <div class="item-content">
                            <div class="item-info">
                                <h5 class="item-name">${escapeHtml(item.name || 'Unnamed')}</h5>
                                <span class="item-category">${getCategoryFromName(item.name)}</span>
                                ${item.notes ? `<p class="item-notes">${escapeHtml(item.notes)}</p>` : ''}
                            </div>
                        </div>
                        <div class="item-actions">
                            <button class="action-btn notes" onclick="editNotes('${itemId}')" title="Ghi chú">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14,2 14,8 20,8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                </svg>
                            </button>
                            <button class="action-btn edit" onclick="editItem('${itemId}')" title="Sửa">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                </svg>
                            </button>
                            <button class="action-btn delete" onclick="deleteItem('${itemId}')" title="Xóa">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="3,6 5,6 21,6"></polyline>
                                    <path d="M19,6v14a2,2 0 0,1 -2,2H7a2,2 0 0,1 -2,-2V6m3,0V4a2,2 0 0,1 2,-2h4a2,2 0 0,1 2,2v2"></path>
                                    <line x1="10" y1="11" x2="10" y2="17"></line>
                                    <line x1="14" y1="11" x2="14" y2="17"></line>
                                </svg>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');

            filterItems();
        }

        function showEmptyState() {
            document.getElementById('shoppingItems').innerHTML = '';
            document.getElementById('emptyState').style.display = 'block';
            updateStats();
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function getCategoryFromName(name) {
            const lower = name.toLowerCase();
            if (lower.includes('thịt') || lower.includes('gà') || lower.includes('cá') || lower.includes('meat')) return 'meat';
            if (lower.includes('rau') || lower.includes('cà') || lower.includes('vegetable')) return 'vegetables';
            if (lower.includes('gạo') || lower.includes('mì') || lower.includes('rice') || lower.includes('grain')) return 'grains';
            if (lower.includes('sữa') || lower.includes('trứng') || lower.includes('milk') || lower.includes('egg')) return 'dairy';
            if (lower.includes('muối') || lower.includes('đường') || lower.includes('spice')) return 'spices';
            return 'other';
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            loadShoppingItems();

            // Search functionality
            const searchInput = document.getElementById('searchInput');
            searchInput.addEventListener('input', function() {
                filterItems();
            });

            // Category filter functionality
            const categoryFilter = document.getElementById('categoryFilter');
            categoryFilter.addEventListener('change', function() {
                filterItems();
            });
        });

        // Update statistics
        function updateStats() {
            const totalItems = shoppingItems.length;
            const completedItems = shoppingItems.filter(item => item.status === 'completed' || item.status === 'draft').length;
            const remainingItems = totalItems - completedItems;

            document.getElementById('totalItems').textContent = totalItems;
            document.getElementById('completedItems').textContent = completedItems;
            document.getElementById('remainingItems').textContent = remainingItems;
        }

        // Filter items based on search and category
        function filterItems() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const selectedCategory = document.getElementById('categoryFilter').value;
            const items = document.querySelectorAll('.shopping-item');

            items.forEach(item => {
                const itemName = item.querySelector('.item-name').textContent.toLowerCase();
                const itemCategory = item.getAttribute('data-category');
                
                const matchesSearch = itemName.includes(searchTerm);
                const matchesCategory = !selectedCategory || itemCategory === selectedCategory;
                
                if (matchesSearch && matchesCategory) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        // Toggle item status (active/completed)
        async function toggleItemStatus(itemId) {
            const item = shoppingItems.find(i => (i.id || i._id) === itemId);
            if (!item) return;

            const newStatus = item.status === 'active' ? 'completed' : 'active';
            
            try {
                const response = await fetch('/api/ShoppingListApi', {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    credentials: 'include',
                    body: JSON.stringify({
                        shoppingItemId: itemId,
                        name: item.name,
                        notes: item.notes || '',
                        status: newStatus
                    })
                });

                if (response.ok) {
                    item.status = newStatus;
                    renderItems();
                    updateStats();
                    console.log('✅ Updated item status');
                } else {
                    console.error('Failed to update item status');
                    // Revert checkbox
                    const checkbox = document.getElementById(`checkbox_${itemId}`);
                    if (checkbox) checkbox.checked = !checkbox.checked;
                }
            } catch (error) {
                console.error('Error updating item status:', error);
                // Revert checkbox
                const checkbox = document.getElementById(`checkbox_${itemId}`);
                if (checkbox) checkbox.checked = !checkbox.checked;
            }
        }

        // Add new item function
        async function addNewItem() {
            const itemName = prompt('Nhập tên item:');
            if (!itemName || !itemName.trim()) return;

            const notes = prompt('Ghi chú (tùy chọn):') || '';

            try {
                const response = await fetch('/api/ShoppingListApi', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    credentials: 'include',
                    body: JSON.stringify({
                        name: itemName.trim(),
                        notes: notes.trim(),
                        status: 'active'
                    })
                });

                if (response.ok) {
                    const newItem = await response.json();
                    console.log('✅ Added shopping item via CookMate API');
                    await loadShoppingItems(); // Reload to get updated list
                } else {
                    const error = await response.json();
                    alert('Lỗi: ' + (error.message || 'Không thể thêm item'));
                }
            } catch (error) {
                console.error('Error adding item:', error);
                alert('Có lỗi xảy ra khi thêm item');
            }
        }

        // Edit item function
        async function editItem(itemId) {
            const item = shoppingItems.find(i => (i.id || i._id) === itemId);
            if (!item) return;

            const newName = prompt('Sửa tên item:', item.name || '');
            if (!newName || !newName.trim() || newName === item.name) return;

            const newNotes = prompt('Sửa ghi chú:', item.notes || '') || '';

            try {
                const response = await fetch('/api/ShoppingListApi', {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    credentials: 'include',
                    body: JSON.stringify({
                        shoppingItemId: itemId,
                        name: newName.trim(),
                        notes: newNotes.trim(),
                        status: item.status || 'active'
                    })
                });

                if (response.ok) {
                    console.log('✅ Updated shopping item via CookMate API');
                    await loadShoppingItems(); // Reload
                } else {
                    const error = await response.json();
                    alert('Lỗi: ' + (error.message || 'Không thể sửa item'));
                }
            } catch (error) {
                console.error('Error updating item:', error);
                alert('Có lỗi xảy ra khi sửa item');
            }
        }

        // Delete item function
        async function deleteItem(itemId) {
            if (!confirm('Bạn có chắc muốn xóa item này?')) return;

            try {
                const response = await fetch(`/api/ShoppingListApi/${itemId}`, {
                    method: 'DELETE',
                    credentials: 'include'
                });

                if (response.ok) {
                    console.log('✅ Deleted shopping item via CookMate API');
                    await loadShoppingItems(); // Reload
                } else {
                    const error = await response.json();
                    alert('Lỗi: ' + (error.message || 'Không thể xóa item'));
                }
            } catch (error) {
                console.error('Error deleting item:', error);
                alert('Có lỗi xảy ra khi xóa item');
            }
        }

        // Edit notes function
        async function editNotes(itemId) {
            const item = shoppingItems.find(i => (i.id || i._id) === itemId);
            if (!item) return;

            const newNotes = prompt('Sửa ghi chú:', item.notes || '') || '';
            if (newNotes === item.notes) return;

            try {
                const response = await fetch('/api/ShoppingListApi', {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    credentials: 'include',
                    body: JSON.stringify({
                        shoppingItemId: itemId,
                        name: item.name,
                        notes: newNotes.trim(),
                        status: item.status || 'active'
                    })
                });

                if (response.ok) {
                    console.log('✅ Updated notes via CookMate API');
                    await loadShoppingItems(); // Reload
                } else {
                    const error = await response.json();
                    alert('Lỗi: ' + (error.message || 'Không thể sửa ghi chú'));
                }
            } catch (error) {
                console.error('Error updating notes:', error);
                alert('Có lỗi xảy ra khi sửa ghi chú');
            }
        }

        // Pagination functionality
        document.addEventListener('DOMContentLoaded', function() {
            const paginationBtns = document.querySelectorAll('.pagination-btn');
            
            paginationBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    // Remove active class from all buttons
                    paginationBtns.forEach(b => b.classList.remove('active'));
                    
                    // Add active class to clicked button (if it's a number)
                    if (!isNaN(this.textContent.trim())) {
                        this.classList.add('active');
                    }
                });
            });
        });
    </script>
}
