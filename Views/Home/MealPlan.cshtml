        // Open edit meal plan modal
        function openEditMealPlanModal() {
            if (!selectedMealPlan) {
                alert('Chưa có kế hoạch để sửa!');
                return;
            }

            isEditMode = true;
            document.getElementById('modalTitle').textContent = 'Sửa kế hoạch bữa ăn';
            document.getElementById('mealPlanName').value = selectedMealPlan.name || '';
            document.getElementById('mealPlanRecipeIds').value = (selectedMealPlan.recipeIds || []).join(', ');
            
            // Extract mealType, imageUrl, and userNotes from notes
            // Format: "mealType:breakfast\n\nimageUrl:https://...\n\n[user notes]"
            let mealType = 'breakfast'; // default
            let imageUrl = '';
            let userNotes = '';
            
            if (selectedMealPlan.mealType) {
                mealType = selectedMealPlan.mealType;
            }
            
            if (selectedMealPlan.notes) {
                // Extract mealType
                const mealTypeMatch = selectedMealPlan.notes.match(/mealType:(\w+)/);
                if (mealTypeMatch) {
                    mealType = mealTypeMatch[1];
                }
                
                // Extract imageUrl
                const imageUrlMatch = selectedMealPlan.notes.match(/imageUrl:(https?:\/\/[^\s\n]+)/);
                if (imageUrlMatch) {
                    imageUrl = imageUrlMatch[1];
                }
                
                // Extract user notes (everything after imageUrl, or after mealType if no imageUrl)
                // Remove mealType and imageUrl lines to get user notes
                let cleanedNotes = selectedMealPlan.notes
                    .replace(/mealType:\w+\n\n?/g, '')
                    .replace(/imageUrl:https?:\/\/[^\s\n]+\n\n?/g, '')
                    .trim();
                
                userNotes = cleanedNotes;
            }
            
            document.getElementById('mealPlanType').value = mealType;
            document.getElementById('mealPlanImageUrl').value = imageUrl;
            document.getElementById('mealPlanNotes').value = userNotes;
            updateImagePreview(imageUrl);
            
            document.getElementById('mealPlanModal').style.display = 'block';
            hideHeaderAndNav(); // Hide header and navigation
        }

