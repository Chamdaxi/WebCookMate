        // Render meal plan
        async function renderMealPlan(recipeIds, plan) {
            // Show action buttons when meal plan is selected
            document.getElementById('actionButtons').style.display = 'flex';
            
            // Clear existing items
            document.getElementById('breakfastItems').innerHTML = '<p style="color: #999; padding: 20px; text-align: center;">Đang tải...</p>';
            document.getElementById('lunchItems').innerHTML = '<p style="color: #999; padding: 20px; text-align: center;">Đang tải...</p>';
            document.getElementById('dinnerItems').innerHTML = '<p style="color: #999; padding: 20px; text-align: center;">Đang tải...</p>';

            if (!recipeIds || recipeIds.length === 0) {
                document.getElementById('breakfastItems').innerHTML = 
                    '<p style="color: #999; padding: 20px; text-align: center;">Chưa có món ăn nào</p>';
                document.getElementById('lunchItems').innerHTML = '';
                document.getElementById('dinnerItems').innerHTML = '';
                updateMealStats(0, 0);
                return;
            }

            // Load recipe details from API
            try {
                console.log('🔄 Loading recipe details for IDs:', recipeIds);
                console.log('🔄 Recipe IDs type:', typeof recipeIds[0], 'Sample:', recipeIds[0]);
                
                // Filter and clean recipe IDs - remove any non-numeric prefixes/suffixes
                const cleanedIds = recipeIds.map(id => {
                    const str = String(id).trim();
                    // Extract numeric part if ID contains numbers
                    const numericMatch = str.match(/\d+/);
                    if (numericMatch) {
                        return numericMatch[0];
                    }
                    return str;
                }).filter(id => id && id !== '');
                
                console.log('🔄 Cleaned recipe IDs:', cleanedIds);
                
                if (cleanedIds.length === 0) {
                    console.warn('⚠️ No valid recipe IDs after cleaning');
                    renderMealPlanFallback(recipeIds, plan);
                    return;
                }
                
                const idsParam = cleanedIds.join(',');
                const response = await fetch(`/api/MealPlansApi/recipes?ids=${encodeURIComponent(idsParam)}`, {
                    method: 'GET',
                    credentials: 'include'
                });

                if (!response.ok) {
                    console.error('❌ Failed to load recipe details:', response.status);
                    // Fallback: show recipe IDs without images
                    renderMealPlanFallback(recipeIds, plan);
                    return;
                }

                const recipes = await response.json();
                console.log('✅ Loaded recipe details:', recipes);

                if (!recipes || recipes.length === 0) {
                    console.warn('⚠️ No recipes found, using fallback');
                    renderMealPlanFallback(recipeIds, plan);
                    return;
                }

                // Clear loading messages
                document.getElementById('breakfastItems').innerHTML = '';
                document.getElementById('lunchItems').innerHTML = '';
                document.getElementById('dinnerItems').innerHTML = '';

                // Create a map of recipe ID to recipe data for quick lookup
                const recipeMap = new Map();
                recipes.forEach(recipe => {
                    const recipeId = recipe.id?.toString() || recipe.Id?.toString() || '';
                    if (recipeId) {
                        // Store with both cleaned ID and original ID for lookup
                        recipeMap.set(recipeId, recipe);
                        // Also store with just numeric part for easier matching
                        const numericMatch = recipeId.match(/(\d+)/);
                        if (numericMatch && numericMatch[1] !== recipeId) {
                            recipeMap.set(numericMatch[1], recipe);
                        }
                    }
                });
                
                console.log('📋 Recipe map keys:', Array.from(recipeMap.keys()));

                // Get mealType from plan notes or stored mealType
                let mealType = 'breakfast'; // default
                if (plan.mealType) {
                    mealType = plan.mealType;
                } else if (plan.notes) {
                    const match = plan.notes.match(/mealType:(\w+)/);
                    if (match) {
                        mealType = match[1];
                    }
                }

                // Remove duplicates from recipeIds before rendering
                const uniqueRecipeIds = [...new Set(recipeIds.map(id => {
                    const str = String(id).trim();
                    // Extract numeric part if ID contains "Recipe ID: " or other prefixes
                    const numericMatch = str.match(/(\d+)/);
                    if (numericMatch) {
                        return numericMatch[1];
                    }
                    return str.replace(/^Recipe ID:\s*/i, '').trim();
                }))];
                
                console.log('🔄 Rendering unique recipe IDs:', uniqueRecipeIds);
                console.log('🔄 Meal type:', mealType);

                // Distribute recipes to the correct meal category based on mealType
                uniqueRecipeIds.forEach((recipeId) => {
                    // Try to find recipe by cleaned ID
                    const recipe = recipeMap.get(recipeId.toString()) || null;
                    const recipeTitle = recipe?.title || recipe?.Title || `Recipe #${recipeId}`;
                    const recipeImage = recipe?.image || recipe?.Image || '';
                    const readyInMinutes = recipe?.readyInMinutes || recipe?.ReadyInMinutes || 0;
                    const servings = recipe?.servings || recipe?.Servings || 0;

                    // Create image URL or placeholder
                    let imageUrl = 'data:image/svg+xml;base64,';
                    if (recipeImage) {
                        imageUrl = recipeImage.startsWith('http') ? recipeImage : `https://${recipeImage}`;
                    }

                    const mealItem = `
                        <div class="meal-item">
                            <div class="meal-checkbox">
                                <input type="checkbox" id="recipe_${recipeId}" class="checkbox-input" onchange="updateMealStats()">
                                <label for="recipe_${recipeId}" class="checkbox-label"></label>
                            </div>
                            <div class="meal-content">
                                <h5 class="meal-name">${escapeHtml(recipeTitle)}</h5>
                                <p class="meal-info">
                                    ${readyInMinutes > 0 ? readyInMinutes + ' phút' : ''}
                                    ${servings > 0 ? ' • ' + servings + ' phần' : ''}
                                </p>
                            </div>
                            <div class="meal-image">
                                <img src="${imageUrl}" alt="${escapeHtml(recipeTitle)}" 
                                     onerror="this.onerror=null; this.src='data:image/svg+xml;base64,';">
                            </div>
                        </div>
                    `;
                    
                    // Add to the correct category based on mealType (only one category per meal plan)
                    if (mealType === 'breakfast') {
                        document.getElementById('breakfastItems').innerHTML += mealItem;
                    } else if (mealType === 'lunch') {
                        document.getElementById('lunchItems').innerHTML += mealItem;
                    } else if (mealType === 'dinner') {
                        document.getElementById('dinnerItems').innerHTML += mealItem;
                    } else {
                        // Fallback: add to breakfast if mealType is unknown
                        console.warn('⚠️ Unknown mealType:', mealType, '- adding to breakfast');
                        document.getElementById('breakfastItems').innerHTML += mealItem;
                    }
                });
                
                console.log('✅ Rendered recipes - Breakfast:', document.getElementById('breakfastItems').children.length, 
                           'Lunch:', document.getElementById('lunchItems').children.length,
                           'Dinner:', document.getElementById('dinnerItems').children.length);

                // Show only the selected mealType category, hide others
                const breakfastCategory = document.getElementById('breakfastCategory');
                const lunchCategory = document.getElementById('lunchCategory');
                const dinnerCategory = document.getElementById('dinnerCategory');
                
                // Hide all categories first
                if (breakfastCategory) breakfastCategory.style.display = 'none';
                if (lunchCategory) lunchCategory.style.display = 'none';
                if (dinnerCategory) dinnerCategory.style.display = 'none';
                
                // Show only the selected mealType category
                if (mealType === 'breakfast') {
                    if (breakfastCategory) breakfastCategory.style.display = 'block';
                    if (document.getElementById('breakfastItems').innerHTML === '') {
                        document.getElementById('breakfastItems').innerHTML = 
                            '<p style="color: #999; padding: 20px; text-align: center;">Chưa có món ăn</p>';
                    }
                } else if (mealType === 'lunch') {
                    if (lunchCategory) lunchCategory.style.display = 'block';
                    if (document.getElementById('lunchItems').innerHTML === '') {
                        document.getElementById('lunchItems').innerHTML = 
                            '<p style="color: #999; padding: 20px; text-align: center;">Chưa có món ăn</p>';
                    }
                } else if (mealType === 'dinner') {
                    if (dinnerCategory) dinnerCategory.style.display = 'block';
                    if (document.getElementById('dinnerItems').innerHTML === '') {
                        document.getElementById('dinnerItems').innerHTML = 
                            '<p style="color: #999; padding: 20px; text-align: center;">Chưa có món ăn</p>';
                    }
                }

                updateMealStats(uniqueRecipeIds.length, 0);
            } catch (error) {
                console.error('❌ Error rendering meal plan:', error);
                renderMealPlanFallback(recipeIds, plan);
            }
        }

