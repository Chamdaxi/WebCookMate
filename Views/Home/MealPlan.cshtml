@{
    ViewData["Title"] = "Meal Plan";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/mealplan.css" asp-append-version="true" />
    <style>
        /* Highlight days with meal plans */
        .calendar-day.has-meal-plan {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            font-weight: 600;
            position: relative;
        }
        
        .calendar-day.has-meal-plan::after {
            content: '📅';
            position: absolute;
            top: 2px;
            right: 2px;
            font-size: 10px;
        }
        
        .calendar-day.has-meal-plan.active {
            box-shadow: 0 0 0 3px #667eea;
        }
        
        /* Button danger style */
        .btn-danger {
            background: #dc3545;
            color: white;
            border: none;
        }
        
        .btn-danger:hover {
            background: #c82333;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.4);
        }

        /* Calendar navigation */
        .calendar-navigation {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding: 10px;
        }

        .calendar-nav-btn {
            background: #667eea;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 14px;
        }

        .calendar-nav-btn:hover {
            background: #5568d3;
        }

        .calendar-month-year {
            font-size: 18px;
            font-weight: 600;
            color: #333;
        }

        /* Hide header and navigation when modal is open */
        body.modal-open .header-container,
        body.modal-open .home-text {
            display: none !important;
        }

        /* Modal styles */
        .modal {
            display: none;
            position: fixed;
            z-index: 10000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0,0,0,0.5);
        }

        .modal-content {
            background-color: #fefefe;
            margin: 5% auto;
            padding: 20px;
            border: 1px solid #888;
            width: 90%;
            max-width: 600px;
            border-radius: 10px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid #eee;
        }

        .modal-title {
            font-size: 24px;
            font-weight: 600;
            color: #333;
        }

        .close {
            color: #aaa;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
        }

        .close:hover,
        .close:focus {
            color: #000;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
            color: #333;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 14px;
        }

        .form-group textarea {
            min-height: 80px;
            resize: vertical;
        }

        .recipe-selection {
            margin-top: 10px;
        }

        .recipe-list {
            max-height: 200px;
            overflow-y: auto;
            border: 1px solid #ddd;
            border-radius: 5px;
            padding: 10px;
        }

        .recipe-item {
            display: flex;
            align-items: center;
            padding: 8px;
            border-bottom: 1px solid #eee;
        }

        .recipe-item:last-child {
            border-bottom: none;
        }

        .recipe-item input[type="checkbox"] {
            margin-right: 10px;
        }
    </style>
}

<!-- Main Content -->
<div class="mealplan-page">
    <!-- Page Header -->
    <div class="mealplan-header">
        <h1 class="page-title">Kế hoạch bữa ăn</h1>
        <p class="page-subtitle">Quản lý và lên lịch các bữa ăn trong tuần</p>
    </div>

    <!-- Main Content Grid -->
    <div class="mealplan-content">
        <!-- Calendar Section -->
        <div class="calendar-section">
        <div class="calendar-header">
            <div class="calendar-icon">
                <svg width="65" height="65" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
            </div>
            <h2 class="calendar-title">Lịch</h2>
        </div>
        
        <div class="calendar-container">
            <!-- Calendar Navigation -->
            <div class="calendar-navigation">
                <button class="calendar-nav-btn" onclick="changeMonth(-1)">← Tháng trước</button>
                <div class="calendar-month-year" id="calendarMonthYear"></div>
                <button class="calendar-nav-btn" onclick="changeMonth(1)">Tháng sau →</button>
            </div>
            
            <div class="calendar-grid">
                <div class="calendar-header-row">
                    <div class="day-header">CN</div>
                    <div class="day-header">Thứ2</div>
                    <div class="day-header">Thứ3</div>
                    <div class="day-header">Thứ4</div>
                    <div class="day-header">Thứ5</div>
                    <div class="day-header">Thứ6</div>
                    <div class="day-header">Thứ7</div>
                </div>
                <div id="calendarDays"></div>
            </div>
        </div>
    </div>

    <!-- Meal Plan Details Section -->
    <div class="mealplan-details-section">
        <!-- Date Header -->
        <div class="date-header">
            <div class="date-icon">
                <svg width="39" height="39" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
            </div>
            <div class="date-info">
                <h3 class="date-text" id="selectedDateText">Chọn ngày</h3>
                <p class="meal-type" id="selectedMealPlanName">Chưa chọn kế hoạch</p>
                <div id="mealPlanHeaderImage" style="display: none;"></div>
            </div>
            <div class="meal-stats">
                <div class="stat-item">
                    <span class="stat-number" id="mealCount">0</span>
                    <span class="stat-label">Món ăn</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number" id="caloriesCount">0</span>
                    <span class="stat-label">Calories</span>
                </div>
            </div>
        </div>

        <!-- Meal Plan Details -->
        <div id="mealPlanDetails">
            <div class="empty-state" style="text-align: center; padding: 40px; color: #999;">
                <p>Chọn ngày trong lịch để xem kế hoạch bữa ăn</p>
            </div>
        </div>

        <!-- Meal Categories (will be rendered dynamically) -->
        <div class="meal-categories" id="mealCategories" style="display: none;">
            <!-- Breakfast -->
            <div class="meal-category" id="breakfastCategory">
                <h4 class="category-title">Bữa sáng</h4>
                <div class="meal-items" id="breakfastItems">
                    <!-- Loaded from API -->
                </div>
            </div>

            <!-- Lunch -->
            <div class="meal-category" id="lunchCategory">
                <h4 class="category-title">Bữa trưa</h4>
                <div class="meal-items" id="lunchItems">
                    <!-- Loaded from API -->
                </div>
            </div>

            <!-- Dinner -->
            <div class="meal-category" id="dinnerCategory">
                <h4 class="category-title">Bữa tối</h4>
                <div class="meal-items" id="dinnerItems">
                    <!-- Loaded from API -->
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons" id="actionButtons" style="display: none;">
            <button class="btn btn-primary" onclick="openAddMealModal()" id="addMealBtn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Thêm món ăn
            </button>
            <button class="btn btn-secondary" onclick="openEditMealPlanModal()" id="editMealPlanBtn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
                Sửa kế hoạch
            </button>
            <button class="btn btn-danger" onclick="deleteMealPlan()" id="deleteMealPlanBtn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="3,6 5,6 21,6"></polyline>
                    <path d="M19,6v14a2,2 0 0,1 -2,2H7a2,2 0 0,1 -2,-2V6m3,0V4a2,2 0 0,1 2,-2h4a2,2 0 0,1 2,2v2"></path>
                    <line x1="10" y1="11" x2="10" y2="17"></line>
                    <line x1="14" y1="11" x2="14" y2="17"></line>
                </svg>
                Xóa kế hoạch
            </button>
        </div>
    </div>
    </div>
</div>

<!-- Add/Edit Meal Plan Modal -->
<div id="mealPlanModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2 class="modal-title" id="modalTitle">Thêm kế hoạch bữa ăn</h2>
            <span class="close" onclick="closeMealPlanModal()">&times;</span>
        </div>
        <form id="mealPlanForm" onsubmit="handleMealPlanSubmit(event)">
            <div class="form-group">
                <label for="mealPlanName">Tên kế hoạch *</label>
                <input type="text" id="mealPlanName" required placeholder="VD: Kế hoạch thứ 2">
            </div>
            <div class="form-group">
                <label for="mealPlanType">Loại bữa ăn *</label>
                <select id="mealPlanType" required style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px; font-size: 14px;">
                    <option value="breakfast">Bữa sáng</option>
                    <option value="lunch">Bữa trưa</option>
                    <option value="dinner">Bữa tối</option>
                </select>
                <small style="color: #666; font-size: 12px;">Chọn loại bữa ăn cho kế hoạch này</small>
            </div>
            <div class="form-group">
                <label>Recipe IDs (phân cách bằng dấu phẩy) *</label>
                <input type="text" id="mealPlanRecipeIds" required placeholder="VD: 715538, 716429, 716426">
                <small style="color: #666; font-size: 12px;">Nhập các Recipe ID phân cách bằng dấu phẩy</small>
            </div>
            <div class="form-group">
                <label for="mealPlanImageUrl">Link ảnh (tùy chọn)</label>
                <input type="url" id="mealPlanImageUrl" placeholder="https://example.com/image.jpg">
                <small style="color: #666; font-size: 12px; line-height: 1.6;">
                    <strong>📌 Cách lấy link ảnh từ Google Images (KHÔNG cần lưu ảnh về máy):</strong><br>
                    1. Tìm ảnh trên Google Images<br>
                    2. <strong>Click vào ảnh</strong> để xem ảnh lớn hơn (không click vào trang web)<br>
                    3. <strong>Click chuột phải vào ảnh</strong> → Chọn <strong>"Copy image address"</strong> (Chrome) hoặc <strong>"Sao chép địa chỉ ảnh"</strong> (Firefox)<br>
                    4. Dán link vào ô trên (link sẽ giống: <code>https://example.com/image.jpg</code>)<br>
                    <br>
                    <strong>✅ Link đúng:</strong> Kết thúc bằng .jpg, .png, .gif, .webp (ví dụ: <code>https://cdn.example.com/photo.jpg</code>)<br>
                    <strong>❌ Link sai:</strong> Bắt đầu bằng <code>google.com/url</code> (đó là link redirect, không phải link ảnh trực tiếp)
                </small>
                <div id="mealPlanImagePreview" style="margin-top: 10px; display: none;">
                    <img id="mealPlanImagePreviewImg" src="" alt="Preview" style="max-width: 100%; max-height: 200px; border-radius: 5px; border: 1px solid #ddd;">
                </div>
            </div>
            <div class="form-group">
                <label for="mealPlanNotes">Ghi chú</label>
                <textarea id="mealPlanNotes" placeholder="Thêm ghi chú cho kế hoạch này..."></textarea>
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
                <button type="button" class="btn btn-secondary" onclick="closeMealPlanModal()">Hủy</button>
                <button type="submit" class="btn btn-primary">Lưu</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Global variables
        let mealPlans = [];
        let selectedMealPlan = null;
        let selectedDate = null;
        let currentMonth = new Date().getMonth();
        let currentYear = new Date().getFullYear();
        let isEditMode = false;

        @if (ViewBag.MealPlans != null)
        {
            <text>
            mealPlans = @Html.Raw(Json.Serialize(ViewBag.MealPlans));
            console.log('✅ Loaded ' + mealPlans.length + ' meal plans from CookMate API');
            </text>
        }

        // Function to reload meal plans from API
        async function reloadMealPlans() {
            try {
                console.log('🔄 Reloading meal plans from API...');
                const response = await fetch('/api/MealPlansApi', {
                    method: 'GET',
                    credentials: 'include'
                });

                if (response.ok) {
                    const data = await response.json();
                    mealPlans = data || [];
                    
                    // Normalize all meal plan IDs to ensure consistency
                    mealPlans.forEach(plan => {
                        if (!plan.id && (plan._id || plan._Id)) {
                            plan.id = plan._id || plan._Id;
                        }
                    });
                    
                    console.log('✅ Reloaded ' + mealPlans.length + ' meal plans from API');
                    if (mealPlans.length > 0) {
                        console.log('📋 First meal plan:', { 
                            id: mealPlans[0].id, 
                            name: mealPlans[0].name, 
                            date: mealPlans[0].date 
                        });
                    }
                    
                    // Refresh calendar to show updated data
                    renderCalendar();
                    
                    // If a date was selected, update the display
                    if (selectedDate) {
                        updateMealPlanForDay(selectedDate);
                    }
                    
                    return true;
                } else {
                    const errorText = await response.text();
                    console.error('❌ Failed to reload meal plans:', response.status, errorText);
                    return false;
                }
            } catch (error) {
                console.error('❌ Error reloading meal plans:', error);
                return false;
            }
        }

        // Update image preview when URL changes
        function updateImagePreview(imageUrl) {
            const previewDiv = document.getElementById('mealPlanImagePreview');
            
            if (!previewDiv) {
                return; // Element not found
            }
            
            if (imageUrl && imageUrl.trim()) {
                let displayUrl = imageUrl.trim();
                
                // Handle Google redirect URLs - try to extract actual image URL
                if (displayUrl.includes('google.com/url') && displayUrl.includes('url=')) {
                    try {
                        const urlMatch = displayUrl.match(/url=([^&]+)/);
                        if (urlMatch) {
                            displayUrl = decodeURIComponent(urlMatch[1]);
                            console.log('🔄 Extracted URL from Google redirect for preview:', displayUrl);
                            // Update the input field with the extracted URL (optional, user can keep original)
                            // document.getElementById('mealPlanImageUrl').value = displayUrl;
                        }
                    } catch (e) {
                        console.warn('⚠️ Failed to extract URL from Google redirect:', e);
                    }
                }
                
                // Create new img element to avoid caching issues
                const img = document.createElement('img');
                img.id = 'mealPlanImagePreviewImg';
                img.src = displayUrl;
                img.alt = 'Preview';
                img.style.cssText = 'max-width: 100%; max-height: 200px; border-radius: 5px; border: 1px solid #ddd;';
                
                // Handle image load error
                img.onerror = function() {
                    console.error('❌ Failed to load image preview:', displayUrl);
                    previewDiv.innerHTML = `<div style="color: #d32f2f; padding: 10px; border: 1px solid #d32f2f; border-radius: 5px; background: #ffebee; font-size: 12px;">
                        <p style="margin: 0 0 5px 0;"><strong>⚠️ Không thể tải ảnh từ link này</strong></p>
                        <p style="margin: 0 0 5px 0; font-size: 11px;">Link: <code style="background: #fff; padding: 2px 4px; border-radius: 2px; font-size: 10px; word-break: break-all;">${escapeHtml(displayUrl.substring(0, 60))}...</code></p>
                        <p style="margin: 0; font-size: 11px; color: #666;">📌 <strong>Hướng dẫn:</strong> Sử dụng link ảnh trực tiếp (kết thúc bằng .jpg, .png, .gif)</p>
                        <p style="margin: 5px 0 0 0; font-size: 11px; color: #666;">👉 Click chuột phải vào ảnh → "Copy image address" để lấy link trực tiếp</p>
                    </div>`;
                };
                
                // Handle image load success
                img.onload = function() {
                    console.log('✅ Image preview loaded successfully:', displayUrl);
                    previewDiv.innerHTML = '';
                    previewDiv.appendChild(img);
                };
                
                previewDiv.innerHTML = '<p style="color: #666; padding: 10px; text-align: center; font-size: 12px;">Đang tải ảnh...</p>';
                previewDiv.style.display = 'block';
            } else {
                previewDiv.innerHTML = '';
                previewDiv.style.display = 'none';
            }
        }

        // Initialize calendar on page load and setup image URL preview
        document.addEventListener('DOMContentLoaded', function() {
            renderCalendar();
            markDaysWithMealPlans();
            
            // Setup image URL preview
            const imageUrlInput = document.getElementById('mealPlanImageUrl');
            if (imageUrlInput) {
                imageUrlInput.addEventListener('input', function() {
                    updateImagePreview(this.value);
                });
                
                imageUrlInput.addEventListener('paste', function() {
                    // Wait a bit for paste to complete
                    setTimeout(() => {
                        updateImagePreview(this.value);
                    }, 100);
                });
            }
        });

        // Render calendar for current month
        function renderCalendar() {
            const monthNames = ['Tháng 1', 'Tháng 2', 'Tháng 3', 'Tháng 4', 'Tháng 5', 'Tháng 6',
                              'Tháng 7', 'Tháng 8', 'Tháng 9', 'Tháng 10', 'Tháng 11', 'Tháng 12'];
            
            document.getElementById('calendarMonthYear').textContent = 
                monthNames[currentMonth] + ' ' + currentYear;

            const firstDay = new Date(currentYear, currentMonth, 1).getDay();
            const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
            
            let calendarHTML = '';
            let day = 1;

            // Create weeks
            for (let week = 0; week < 6; week++) {
                calendarHTML += '<div class="calendar-week">';
                
                for (let weekday = 0; weekday < 7; weekday++) {
                    if ((week === 0 && weekday < firstDay) || day > daysInMonth) {
                        calendarHTML += '<div class="calendar-day"></div>';
                    } else {
                        const dayDate = new Date(currentYear, currentMonth, day);
                        const dateStr = formatDateString(dayDate);
                        calendarHTML += 
                            `<div class="calendar-day" data-date="${dateStr}" onclick="selectDate('${dateStr}', ${day})">${day}</div>`;
                        day++;
                    }
                }
                
                calendarHTML += '</div>';
                if (day > daysInMonth) break;
            }

            document.getElementById('calendarDays').innerHTML = calendarHTML;
            markDaysWithMealPlans();
        }

        // Change month
        function changeMonth(direction) {
            currentMonth += direction;
            if (currentMonth < 0) {
                currentMonth = 11;
                currentYear--;
            } else if (currentMonth > 11) {
                currentMonth = 0;
                currentYear++;
            }
            renderCalendar();
        }

        // Format date string (YYYY-MM-DD)
        function formatDateString(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        // Select date
        function selectDate(dateStr, dayNumber) {
            selectedDate = dateStr;
            
            // Remove active class from all days
            document.querySelectorAll('.calendar-day').forEach(d => d.classList.remove('active'));
            
            // Add active class to selected day
            const dayElement = document.querySelector(`[data-date="${dateStr}"]`);
            if (dayElement) {
                dayElement.classList.add('active');
            }

            // Update date header
            const date = new Date(dateStr);
            const dateText = document.getElementById('selectedDateText');
            if (dateText) {
                const dayNames = ['Chủ nhật', 'Thứ 2', 'Thứ 3', 'Thứ 4', 'Thứ 5', 'Thứ 6', 'Thứ 7'];
                dateText.textContent = `${dayNames[date.getDay()]}, ${dayNumber}/${date.getMonth() + 1}/${date.getFullYear()}`;
            }

            // Update meal plan for selected day
            updateMealPlanForDay(dateStr);
        }

        // Mark calendar days that have meal plans
        function markDaysWithMealPlans() {
            if (!mealPlans || mealPlans.length === 0) {
                // Remove all marks if no meal plans
                document.querySelectorAll('.calendar-day').forEach(d => {
                    d.classList.remove('has-meal-plan');
                    d.removeAttribute('data-meal-plan-id');
                });
                return;
            }

            // Remove all existing marks
            document.querySelectorAll('.calendar-day').forEach(d => {
                d.classList.remove('has-meal-plan');
                d.removeAttribute('data-meal-plan-id');
            });

            let markedCount = 0;
            mealPlans.forEach(plan => {
                if (!plan.date) return;
                
                // Normalize ID if needed
                if (!plan.id && (plan._id || plan._Id)) {
                    plan.id = plan._id || plan._Id;
                }
                
                try {
                    const planDate = new Date(plan.date);
                    // Check if meal plan is in current month
                    if (planDate.getMonth() === currentMonth && planDate.getFullYear() === currentYear) {
                        const dateStr = formatDateString(planDate);
                        const dayElement = document.querySelector(`[data-date="${dateStr}"]`);
                        if (dayElement) {
                            dayElement.classList.add('has-meal-plan');
                            dayElement.setAttribute('data-meal-plan-id', plan.id || '');
                            markedCount++;
                        }
                    }
                } catch (e) {
                    console.warn('⚠️ Error parsing date for meal plan:', plan.date, e);
                }
            });
            
            if (markedCount > 0) {
                console.log(`✅ Marked ${markedCount} days with meal plans in calendar`);
            }
        }

        // Update meal plan for selected day
        function updateMealPlanForDay(dateStr) {
            // Find meal plan for this date (compare date strings)
            const plan = mealPlans.find(p => {
                if (!p.date) return false;
                const planDate = new Date(p.date);
                const planDateStr = formatDateString(planDate);
                return planDateStr === dateStr;
            });

            if (!plan) {
                // No meal plan for this day
                document.getElementById('mealPlanDetails').innerHTML = `
                    <div class="empty-state" style="text-align: center; padding: 40px; color: #999;">
                        <p>Chưa có kế hoạch bữa ăn cho ngày này</p>
                        <button class="btn btn-primary" onclick="openAddMealModal()" style="margin-top: 20px;">
                            Tạo kế hoạch mới
