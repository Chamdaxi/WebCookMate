            isEditMode = false;
            showHeaderAndNav(); // Show header and navigation
        }


        // Handle meal plan form submit
        async function handleMealPlanSubmit(event) {
            event.preventDefault();

            const name = document.getElementById('mealPlanName').value.trim();
            const mealType = document.getElementById('mealPlanType').value;
            const imageUrl = document.getElementById('mealPlanImageUrl').value.trim();
            const notes = document.getElementById('mealPlanNotes').value.trim();
            const recipeIdsInput = document.getElementById('mealPlanRecipeIds').value.trim();
            const recipeIds = recipeIdsInput.split(',').map(id => id.trim()).filter(id => id);

            if (!name || recipeIds.length === 0 || !mealType) {
                alert('Vui lòng điền đầy đủ thông tin!');
                return;
            }

            if (!selectedDate) {
                alert('Vui lòng chọn ngày!');
                return;
            }

            const date = new Date(selectedDate + 'T00:00:00');

            // Combine notes with mealType and imageUrl (format: "mealType:breakfast\n\nimageUrl:https://...\n\n[user notes]")
            let combinedNotes = `mealType:${mealType}`;
            if (imageUrl) {
                combinedNotes += `\n\nimageUrl:${imageUrl}`;
            }
            if (notes) {
                combinedNotes += '\n\n' + notes;
            }

            try {
                let response;
                if (isEditMode && selectedMealPlan) {
                    // Validate plan ID
                    const planId = selectedMealPlan.id || selectedMealPlan._id || selectedMealPlan._Id;
                    if (!planId) {
                        console.error('❌ Update failed: Meal plan ID is missing', selectedMealPlan);
                        alert('Lỗi: Không tìm thấy ID của kế hoạch bữa ăn. Vui lòng thử lại.');
                        return;
                    }

                    // Ensure date is valid
                    if (!date || isNaN(date.getTime())) {
                        alert('Lỗi: Ngày không hợp lệ!');
                        return;
                    }

                    // Prepare request body
                    const requestBody = {
                        mealPlanId: planId,
                        name: name,
                        recipeIds: recipeIds,
                        date: date.toISOString(), // ISO 8601 format
                        notes: combinedNotes
                    };

                    console.log('🔄 Updating meal plan:', requestBody);

                    // Update existing meal plan
                    response = await fetch('/api/MealPlansApi', {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        credentials: 'include',
                        body: JSON.stringify(requestBody)
                    });
                } else {
                    // Create new meal plan
                    response = await fetch('/api/MealPlansApi', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        credentials: 'include',
                        body: JSON.stringify({
                            name: name,
                            recipeIds: recipeIds,
                            date: date.toISOString(),
                            notes: combinedNotes
                        })
                    });
                }

                if (response.ok) {
                    const mealPlan = await response.json();
                    
                    // Normalize meal plan ID
                    if (!mealPlan.id && (mealPlan._id || mealPlan._Id)) {
                        mealPlan.id = mealPlan._id || mealPlan._Id;
                    }
                    
                    // Store mealType in mealPlan object for easy access
                    if (mealPlan.notes) {
                        const match = mealPlan.notes.match(/mealType:(\w+)/);
                        if (match) {
                            mealPlan.mealType = match[1];
                        }
                    } else {
                        mealPlan.mealType = mealType; // Use the one we just set
                    }
                    
                    console.log('✅ ' + (isEditMode ? 'Updated' : 'Created') + ' meal plan:', mealPlan);
                    
                    // Reload all meal plans from API to get latest data
                    console.log('🔄 Reloading meal plans after ' + (isEditMode ? 'update' : 'create') + '...');
                    const reloadSuccess = await reloadMealPlans();
                    
                    if (reloadSuccess) {
                        // Update selected date display if still selected
                        if (selectedDate) {
                            console.log('🔄 Updating display for selected date:', selectedDate);
                            updateMealPlanForDay(selectedDate);
                        }
                        
                        closeMealPlanModal(); // This will show header and navigation
                        alert('Đã ' + (isEditMode ? 'sửa' : 'tạo') + ' kế hoạch bữa ăn thành công!');
                    } else {
                        console.warn('⚠️ Reload failed, using fallback update');
                        // If reload failed, still update local array as fallback
                        if (isEditMode) {
                            const planId = selectedMealPlan.id || selectedMealPlan._id || selectedMealPlan._Id;
                            const index = mealPlans.findIndex(p => {
                                const pId = p.id || p._id || p._Id;
                                return pId === planId;
                            });
                            if (index !== -1) {
                                mealPlans[index] = mealPlan;
                            }
                        } else {
                            mealPlans.push(mealPlan);
                        }
                        renderCalendar();
                        if (selectedDate) {
                            updateMealPlanForDay(selectedDate);
                        }
                        closeMealPlanModal();
                        alert('Đã ' + (isEditMode ? 'sửa' : 'tạo') + ' kế hoạch bữa ăn thành công!');
                    }
                } else {
                    const errorData = await response.json().catch(() => ({ message: 'Unknown error' }));
                    console.error('❌ API Error:', errorData);
                    alert('Lỗi: ' + (errorData.message || 'Không thể ' + (isEditMode ? 'sửa' : 'tạo') + ' kế hoạch'));
                }
            } catch (error) {
                console.error('❌ Error ' + (isEditMode ? 'updating' : 'creating') + ' meal plan:', error);
                alert('Có lỗi xảy ra khi ' + (isEditMode ? 'sửa' : 'tạo') + ' kế hoạch: ' + error.message);
            }
        }

        // Delete meal plan
        async function deleteMealPlan() {
            if (!selectedMealPlan) {
                alert('Chưa có kế hoạch để xóa!');
                return;
            }

            // Validate plan ID
            const planId = selectedMealPlan.id || selectedMealPlan._id || selectedMealPlan._Id;
            if (!planId) {
                console.error('❌ Delete failed: Meal plan ID is missing', selectedMealPlan);
                alert('Lỗi: Không tìm thấy ID của kế hoạch bữa ăn. Vui lòng thử lại.');
                return;
            }

            const planName = selectedMealPlan.name || 'kế hoạch này';

            // Hide header and navigation before showing confirm dialog
            hideHeaderAndNav();

            if (!confirm(`Bạn có chắc muốn xóa "${planName}"?`)) {
                showHeaderAndNav(); // Show again if cancelled
                return;
            }

            try {
                console.log('🗑️ Deleting meal plan:', { id: planId, name: planName });
                console.log('🗑️ Delete URL:', `/api/MealPlansApi/${encodeURIComponent(planId)}`);
                
                const response = await fetch(`/api/MealPlansApi/${encodeURIComponent(planId)}`, {
                    method: 'DELETE',
                    credentials: 'include',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                const responseText = await response.text();
                console.log('🗑️ Delete response status:', response.status);
                console.log('🗑️ Delete response text:', responseText);

                if (response.ok) {
                    console.log('✅ Deleted meal plan via CookMate API');
                    
                    // Store deleted date before clearing
                    const deletedDate = selectedDate;
                    
                    // Clear display first
                    document.getElementById('mealPlanDetails').innerHTML = `
                        <div class="empty-state" style="text-align: center; padding: 40px; color: #999;">
                            <p>Chưa có kế hoạch bữa ăn cho ngày này</p>
                            <button class="btn btn-primary" onclick="openAddMealModal()" style="margin-top: 20px;">
                                Tạo kế hoạch mới
                            </button>
                        </div>
                    `;
                    document.getElementById('mealCategories').style.display = 'none';
                    document.getElementById('actionButtons').style.display = 'none';
                    document.getElementById('selectedMealPlanName').textContent = 'Chưa có kế hoạch';
                    document.getElementById('mealCount').textContent = '0';
                    document.getElementById('caloriesCount').textContent = '0';
                    const headerImageDiv = document.getElementById('mealPlanHeaderImage');
                    if (headerImageDiv) {
                        headerImageDiv.innerHTML = '';
                        headerImageDiv.style.display = 'none';
                    }
                    selectedMealPlan = null;
                    
                    // Don't clear selectedDate - keep it so user can see the empty state
                    // selectedDate = null;
                    
                    // Remove active class from calendar day
                    document.querySelectorAll('.calendar-day').forEach(d => d.classList.remove('active'));
                    
                    // Reload all meal plans from API to get latest data
                    console.log('🔄 Reloading meal plans after delete...');
                    const reloadSuccess = await reloadMealPlans();
                    
                    if (reloadSuccess) {
                        console.log('✅ Meal plans reloaded successfully after delete');
                        // Update display for the selected date (should now show empty state)
                        if (selectedDate) {
                            updateMealPlanForDay(selectedDate);
                        }
                    } else {
                        console.warn('⚠️ Reload failed after delete, but deletion was successful');
                    }
                    
                    showHeaderAndNav(); // Show header and navigation after deletion
                    alert('Đã xóa kế hoạch bữa ăn thành công!');
                } else {
                    let errorData;
                    try {
                        errorData = JSON.parse(responseText);
                    } catch {
                        errorData = { message: responseText || 'Unknown error' };
                    }
                    console.error('❌ Delete API Error:', response.status, errorData);
                    showHeaderAndNav(); // Show header and navigation on error
                    alert('Lỗi: ' + (errorData.message || 'Không thể xóa kế hoạch') + ' (Status: ' + response.status + ')');
                }
            } catch (error) {
                console.error('❌ Error deleting meal plan:', error);
                showHeaderAndNav(); // Show header and navigation on error
                alert('Có lỗi xảy ra khi xóa kế hoạch: ' + error.message);
            }
        }

        // Close modal when clicking outside
        window.onclick = function(event) {
            const modal = document.getElementById('mealPlanModal');
            if (event.target === modal) {
                closeMealPlanModal(); // This will show header and navigation
            }
        }

        // Also handle Escape key to close modal
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                const modal = document.getElementById('mealPlanModal');
                if (modal && modal.style.display === 'block') {
                    closeMealPlanModal(); // This will show header and navigation
                }
            }
        });
    </script>
}
