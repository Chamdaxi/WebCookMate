            console.log('📋 Selected meal plan:', { 
                id: plan.id, 
                name: plan.name, 
                date: plan.date,
                recipeIds: plan.recipeIds 
            });
            
            // Extract mealType from notes
            let mealType = 'breakfast'; // default
            if (plan.notes) {
                const match = plan.notes.match(/mealType:(\w+)/);
