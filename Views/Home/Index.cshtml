@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Today's Suggestions -->
<div class="today-suggestions-section">
    <h2 class="section-title">Today's Suggestions</h2>
    <div class="suggestions-grid">
        <div class="suggestion-card">
            <div class="suggestion-image">
                <img src="~/images/recipes/today-suggestion.jpg" alt="Top Cooksnap">
            </div>
            <div class="suggestion-content">
                <h3>Top Món Có Nhiều Cooksnap Nhất</h3>
                <p>Công thức đã nhận được hơn 10 cooksnap</p>
            </div>
        </div>
        
        <div class="suggestion-card">
            <div class="suggestion-image">
                <img src="~/images/recipes/banhmi.jpg" alt="Premium Menu">
            </div>
            <div class="suggestion-content">
                <h3>Thực Đơn Premium</h3>
                <p>Thực đơn hàng tuần với những nguyên liệu theo mùa</p>
            </div>
        </div>
        
        <div class="suggestion-card">
            <div class="suggestion-image">
                <img src="~/images/recipes/phobo.jpeg" alt="Most Viewed">
            </div>
            <div class="suggestion-content">
                <h3>Top Món Được Xem Nhiều Nhất</h3>
                <p>Những công thức có lượt xem nhiều nhất, cập nhật mỗi ngày</p>
            </div>
        </div>
    </div>
</div>

<!-- Most Favorited Recipes Section -->
<div class="recipes-section">
    <div class="recipes-header">
        <h2 class="section-title">Món Ăn Được Yêu Thích Nhất</h2>
        <div class="search-recipes-box">
            <input type="text" id="searchRecipesInput" class="search-recipes-input" placeholder="Tìm kiếm món ăn được yêu thích...">
            <button class="search-recipes-btn" onclick="searchMostFavoritedRecipes()">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
            </button>
        </div>
    </div>
    
    <div class="recipes-grid" id="recipesGrid">
        @if (ViewBag.MostFavoritedRecipes != null)
        {
            @foreach (var item in ViewBag.MostFavoritedRecipes)
            {
                var recipe = item.Recipe;
                <div class="recipe-card" data-recipe-id="@recipe.Id">
                    <div class="recipe-image">
                        <img src="@(recipe.ImageUrl ?? "/images/recipes/today-suggestion.jpg")" alt="@recipe.Name">
                        <div class="recipe-overlay">
                            <button class="recipe-favorite-btn @(item.IsFavorited ? "favorited" : "")" 
                                    onclick="toggleFavorite(@recipe.Id, this)">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="@(item.IsFavorited ? "currentColor" : "none")" stroke="currentColor" stroke-width="2">
                                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="recipe-content">
                        <h3 class="recipe-title">@recipe.Name</h3>
                        <p class="recipe-description">@(recipe.Description ?? "Không có mô tả")</p>
                        <div class="recipe-meta">
                            @if (recipe.CookingTime != null)
                            {
                                <span class="recipe-time">@recipe.CookingTime phút</span>
                            }
                            @if (!string.IsNullOrEmpty(recipe.Difficulty))
                            {
                                <span class="recipe-difficulty">@recipe.Difficulty</span>
                            }
                            @if (!string.IsNullOrEmpty(recipe.Category))
                            {
                                <span class="recipe-category">@recipe.Category</span>
                            }
                        </div>
                        <div class="recipe-stats">
                            <span class="stat-item">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                </svg>
                                <span id="favorite-count-@recipe.Id">@item.FavoriteCount</span>
                            </span>
                            <span class="stat-item">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                </svg>
                                <span id="reaction-count-@recipe.Id">@item.ReactionCount</span>
                            </span>
                            <span class="stat-item">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                </svg>
                                <span id="comment-count-@recipe.Id">@item.CommentCount</span>
                            </span>
                        </div>
                        <div class="recipe-actions">
                            <div class="reaction-buttons">
                                <button class="reaction-btn @(item.UserReaction?.Type == "like" ? "active" : "")" 
                                        onclick="toggleReaction(@recipe.Id, 'like', this)" title="Thích">
                                    👍
                                </button>
                                <button class="reaction-btn @(item.UserReaction?.Type == "love" ? "active" : "")" 
                                        onclick="toggleReaction(@recipe.Id, 'love', this)" title="Yêu thích">
                                    ❤️
                                </button>
                                <button class="reaction-btn @(item.UserReaction?.Type == "wow" ? "active" : "")" 
                                        onclick="toggleReaction(@recipe.Id, 'wow', this)" title="Wow">
                                    😮
                                </button>
                                <button class="reaction-btn @(item.UserReaction?.Type == "haha" ? "active" : "")" 
                                        onclick="toggleReaction(@recipe.Id, 'haha', this)" title="Haha">
                                    😂
                                </button>
                            </div>
                            <button class="comment-btn" onclick="showComments(@recipe.Id)">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                </svg>
                                Bình luận
                            </button>
                        </div>
                        <div class="comments-section" id="comments-@recipe.Id" style="display: none;">
                            <div class="comments-list" id="comments-list-@recipe.Id"></div>
                            <div class="comment-input-box">
                                <input type="text" id="comment-input-@recipe.Id" class="comment-input" placeholder="Viết bình luận...">
                                <button class="comment-submit-btn" onclick="addComment(@recipe.Id)">Gửi</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="no-recipes">
                <p>Chưa có món ăn nào được yêu thích</p>
            </div>
        }
    </div>
</div>

<!-- Meal Plan Today -->
