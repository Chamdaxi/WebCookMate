@using System.Linq
@using demo.Services
@{
    ViewData["Title"] = "Trang chủ";
    var mealPlans = ViewBag.MealPlans as List<CookMateApiService.MealPlan> ?? new List<CookMateApiService.MealPlan>();
    var recipes = ViewBag.Recipes as List<CookMateApiService.Recipe> ?? new List<CookMateApiService.Recipe>();
    var today = DateTime.Today;
    var todayMealPlans = mealPlans.Where(mp => {
        try {
            var date = mp.Date;
            return date.Date == today;
        } catch {
            return false;
        }
    }).ToList();
}

@if (TempData["AccessToken"] != null)
{
    <script>
        // Store access token in localStorage
        localStorage.setItem('accessToken', '@TempData["AccessToken"]');
        console.log('Access token stored in localStorage');
    </script>
}

<!-- Home Page Banner -->
<div class="home-banner">
    <div class="banner-content">
        <h1 class="banner-title">Chào mừng đến với CookMate</h1>
        <p class="banner-subtitle">Khám phá những công thức nấu ăn tuyệt vời và lên kế hoạch bữa ăn hoàn hảo</p>
    </div>
</div>

<!-- Today's Suggestions -->
<div class="today-suggestions-section">
    <h2 class="section-title">Today's Suggestions</h2>
    <div class="suggestions-grid">
        <div class="suggestion-card">
            <div class="suggestion-image">
                <img src="~/images/recipes/today-suggestion.jpg" alt="Top Cooksnap">
            </div>
            <div class="suggestion-content">
                <h3>Top Món Có Nhiều Cooksnap Nhất</h3>
                <p>Công thức đã nhận được hơn 10 cooksnap</p>
            </div>
        </div>
        
        <div class="suggestion-card">
            <div class="suggestion-image">
                <img src="~/images/recipes/banhmi.jpg" alt="Premium Menu">
            </div>
            <div class="suggestion-content">
                <h3>Thực Đơn Premium</h3>
                <p>Thực đơn hàng tuần với những nguyên liệu theo mùa</p>
            </div>
        </div>
        
        <div class="suggestion-card">
            <div class="suggestion-image">
                <img src="~/images/recipes/phobo.jpeg" alt="Most Viewed">
            </div>
            <div class="suggestion-content">
                <h3>Top Món Được Xem Nhiều Nhất</h3>
                <p>Những công thức có lượt xem nhiều nhất, cập nhật mỗi ngày</p>
            </div>
        </div>
    </div>
</div>

<!-- Meal Plan Today -->
<div class="meal-plan-section">
    <h2 class="section-title">Meal Plan Hôm Nay</h2>
    @if (todayMealPlans.Any())
    {
        <div class="meal-plan-cards">
            @foreach (var mealPlan in todayMealPlans)
            {
                <a href="@Url.Action("MealPlan", "Home")" class="meal-card-link" title="Xem chi tiết kế hoạch bữa ăn">
                    <div class="meal-card">
                        <div class="meal-time">@(mealPlan.Name ?? "Kế hoạch bữa ăn")</div>
                        <div class="meal-dish">@(mealPlan.RecipeIds?.Count > 0 ? $"{mealPlan.RecipeIds.Count} món ăn" : "Chưa có món ăn")</div>
                        @if (!string.IsNullOrEmpty(mealPlan.Notes))
                        {
                            <div class="meal-time-info">@mealPlan.Notes</div>
                        }
                        else
                        {
                            <div class="meal-time-info">Hôm nay</div>
                        }
                        <div class="meal-card-action">Xem chi tiết →</div>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="meal-plan-empty">
            <p>Chưa có kế hoạch bữa ăn cho hôm nay. <a href="@Url.Action("MealPlan", "Home")">Tạo kế hoạch mới</a></p>
        </div>
    }
</div>

<!-- Recipe Today -->
<div class="recipe-today-section">
    <h2 class="section-title">Công Thức Hôm Nay</h2>
    @if (recipes.Any())
    {
        <div class="recipes-grid">
            @foreach (var recipe in recipes.Take(6))
            {
                <div class="recipe-card" onclick="window.location.href='@Url.Action("Recipes", "Home")'" style="cursor: pointer;">
                    @if (!string.IsNullOrEmpty(recipe.Image))
                    {
                        <div class="recipe-image">
                            <img src="@recipe.Image" alt="@(recipe.Title ?? "Recipe")" onerror="this.src='https://via.placeholder.com/300x200?text=No+Image'">
                        </div>
                    }
                    <div class="recipe-content">
                        <h3 class="recipe-title">@(recipe.Title ?? "Công thức")</h3>
                        @if (recipe.ReadyInMinutes > 0)
                        {
                            <p class="recipe-time">⏱️ @recipe.ReadyInMinutes phút</p>
                        }
                        @if (recipe.Servings > 0)
                        {
                            <p class="recipe-servings">🍽️ @recipe.Servings phần</p>
                        }
                        <div class="recipe-card-action">Xem chi tiết →</div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="recipe-empty">
            <p>Chưa có công thức đề xuất cho hôm nay. <a href="@Url.Action("Recipes", "Home")">Khám phá công thức</a></p>
        </div>
    }
</div>

<!-- Quick Access -->
<div class="quick-access-section">
    <h2 class="section-title">Quick Access</h2>
    <div class="quick-access-grid">
        <a href="/Home/Chat" class="quick-access-item">
            <div class="quick-access-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
            </div>
            <div class="quick-access-text">
                <h3>AI Chat</h3>
                <p>Get cooking advice</p>
            </div>
        </a>
        
        <a href="/Home/FavoriteList" class="quick-access-item">
            <div class="quick-access-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
            </div>
            <div class="quick-access-text">
                <h3>Favorites</h3>
                <p>Your saved recipes</p>
            </div>
        </a>
        
        <a href="@Url.Action("MealPlan", "Home")" class="quick-access-item">
            <div class="quick-access-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
            </div>
            <div class="quick-access-text">
                <h3>Meal Plan</h3>
                <p>Plan your daily meals</p>
            </div>
        </a>
        <a href="@Url.Action("Recipes", "Home")" class="quick-access-item">
            <div class="quick-access-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                </svg>
            </div>
            <div class="quick-access-text">
                <h3>Recipes</h3>
                <p>Discover delicious recipes</p>
            </div>
        </a>
        
        <a href="#" class="quick-access-item">
            <div class="quick-access-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                    <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                </svg>
            </div>
            <div class="quick-access-text">
                <h3>Shopping List</h3>
                <p>Plan your groceries</p>
            </div>
        </a>
    </div>
</div>

@section Scripts {
    <script>
        // Simple hover effects for suggestion cards
        document.addEventListener('DOMContentLoaded', function() {
            const suggestionCards = document.querySelectorAll('.suggestion-card');
            
            suggestionCards.forEach(card => {
                card.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-5px)';
                });
                
                card.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0)';
                });
            });
        });
    </script>
}