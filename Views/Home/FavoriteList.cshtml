@{
    ViewData["Title"] = "Danh sách yêu thích";
}

<div class="favorite-list-container">
    <!-- Header Section -->
    <div class="favorite-header">
        <div class="header-content">
            <div class="header-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
            </div>
            <div class="header-text">
                <h1>Danh sách yêu thích</h1>
                <p>Những món ăn bạn đã lưu</p>
            </div>
        </div>
        <div class="header-stats">
            <div class="stat-item">
                <span class="stat-number">0</span>
                <span class="stat-label">Món yêu thích</span>
            </div>
        </div>
    </div>

    <!-- Filter and Search Section -->
    <div class="filter-section">
        <div class="search-box">
            <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
            </svg>
            <input type="text" placeholder="Tìm kiếm món yêu thích..." class="search-input" id="favoriteSearchInput">
        </div>
        <div class="filter-controls">
            <div class="filter-buttons">
                <button class="filter-btn active" data-filter="all">Tất cả</button>
                <button class="filter-btn" data-filter="breakfast">Bữa sáng</button>
                <button class="filter-btn" data-filter="lunch">Bữa trưa</button>
                <button class="filter-btn" data-filter="dinner">Bữa tối</button>
                <button class="filter-btn" data-filter="snack">Đồ ăn nhẹ</button>
            </div>
            <div class="sort-controls">
                <select class="sort-select" id="sortSelect">
                    <option value="name">Sắp xếp theo tên</option>
                    <option value="time">Sắp xếp theo thời gian</option>
                    <option value="rating">Sắp xếp theo đánh giá</option>
                    <option value="date">Sắp xếp theo ngày thêm</option>
                </select>
            </div>
            <div class="add-favorite-controls">
                <button class="add-favorite-btn" id="addFavoriteBtn" onclick="openAddFavoriteModal()">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 5v14M5 12h14"></path>
                    </svg>
                    Thêm món yêu thích
                </button>
            </div>
        </div>
    </div>

    <!-- Favorites Grid -->
    <div class="favorites-grid">
        <!-- Favorites will be loaded from API -->
    </div>

    <!-- Empty State (hidden by default) -->
    <div class="empty-state" style="display: none;">
        <div class="empty-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
        </div>
        <h3>Chưa có món yêu thích nào</h3>
        <p>Hãy khám phá và lưu những món ăn bạn thích!</p>
        <div style="display: flex; gap: 15px; justify-content: center; margin-top: 20px; flex-wrap: wrap;">
            <button class="explore-btn" onclick="openAddFavoriteModal()" style="cursor: pointer; border: none; font-family: inherit;">
                Thêm món yêu thích
            </button>
            <a href="@Url.Action("Recipes", "Home")" class="explore-btn" style="text-decoration: none; display: inline-block;">
                Khám phá công thức
            </a>
        </div>
    </div>

    <!-- Add Favorite Modal -->
    <div id="addFavoriteModal" class="modal" style="display: none;">
        <div class="modal-content" style="max-width: 500px;">
            <div class="modal-header">
                <h2>Thêm món yêu thích</h2>
                <span class="close-modal" onclick="closeAddFavoriteModal()">&times;</span>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="recipeIdInput">Recipe ID:</label>
                    <input type="text" id="recipeIdInput" placeholder="Nhập Recipe ID (ví dụ: 645872)" class="form-control">
                    <small style="color: #666; font-size: 12px; margin-top: 5px; display: block;">
                        💡 Bạn có thể tìm Recipe ID từ trang <a href="@Url.Action("Recipes", "Home")" target="_blank" style="color: #667eea;">Công thức</a>
                    </small>
                </div>
                <div id="recipeIdError" style="display: none; color: #d32f2f; padding: 10px; background: #ffebee; border-radius: 5px; margin-top: 10px; font-size: 14px;">
                    <!-- Error message will be displayed here -->
                </div>
                <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px;">
                    <button class="btn-add-favorite" onclick="closeAddFavoriteModal()" style="background: #6c757d;">
                        Hủy
                    </button>
                    <button class="btn-add-favorite" onclick="addFavoriteByRecipeId()">
                        Thêm vào yêu thích
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .favorite-list-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
            padding-top: 200px;
        }

        /* Header Section */
        .favorite-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
            padding: 30px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 20px;
            color: white;
        }

        .header-content {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .header-icon {
            width: 60px;
            height: 60px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
        }

        .header-text h1 {
            font-size: 32px;
            font-weight: 700;
            margin: 0 0 8px 0;
        }

        .header-text p {
            font-size: 16px;
            opacity: 0.9;
            margin: 0;
        }

        .header-stats {
            text-align: center;
        }

        .stat-number {
            display: block;
            font-size: 28px;
            font-weight: 700;
        }

        .stat-label {
            font-size: 14px;
            opacity: 0.9;
        }

        /* Filter Section */
        .filter-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            gap: 20px;
        }

        .search-box {
            position: relative;
            flex: 1;
            max-width: 400px;
        }

        .search-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #666;
        }

        .search-input {
            width: 100%;
            padding: 12px 15px 12px 45px;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            font-size: 16px;
            transition: all 0.3s ease;
            background: white;
        }

        .search-input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .filter-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .filter-buttons {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            flex: 1;
        }

        .sort-controls {
            display: flex;
            align-items: center;
        }

        .sort-select {
            padding: 8px 15px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            background: white;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .sort-select:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .filter-btn {
            padding: 10px 20px;
            border: 2px solid #e0e0e0;
            background: white;
            border-radius: 25px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .filter-btn:hover {
            border-color: #667eea;
            color: #667eea;
        }

        .filter-btn.active {
            background: #667eea;
            border-color: #667eea;
            color: white;
        }

        /* Favorites Grid */
        .favorites-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 25px;
        }

        .favorite-card {
            background: white;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            position: relative;
            animation: fadeInUp 0.5s ease forwards;
            opacity: 0;
        }

        .favorite-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Stagger animation for cards */
        .favorite-card:nth-child(1) { animation-delay: 0.05s; }
        .favorite-card:nth-child(2) { animation-delay: 0.1s; }
        .favorite-card:nth-child(3) { animation-delay: 0.15s; }
        .favorite-card:nth-child(4) { animation-delay: 0.2s; }
        .favorite-card:nth-child(5) { animation-delay: 0.25s; }
        .favorite-card:nth-child(6) { animation-delay: 0.3s; }
        .favorite-card:nth-child(n+7) { animation-delay: 0.35s; }

        .card-image {
            position: relative;
            height: 200px;
            overflow: hidden;
        }

        .card-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .favorite-card:hover .card-image img {
            transform: scale(1.05);
        }

        .card-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .favorite-card:hover .card-overlay {
            opacity: 1;
        }

        .quick-action-btn {
            width: 45px;
            height: 45px;
            background: white;
            border: none;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            color: #333;
        }

        .quick-action-btn:hover {
            background: #667eea;
            color: white;
            transform: scale(1.1);
        }

        .quick-action-btn.remove-btn:hover {
            background: #ff4757;
            color: white;
        }

        .favorite-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            width: 35px;
            height: 35px;
            background: #ff4757;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
        }

        .card-content {
            padding: 20px;
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 10px;
        }

        .card-header h3 {
            font-size: 18px;
            font-weight: 600;
            margin: 0;
            color: #2c3e50;
        }

        .rating {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .stars {
            color: #ffd700;
            font-size: 14px;
        }

        .rating-text {
            font-size: 12px;
            color: #666;
            font-weight: 500;
        }

        .card-description {
            color: #666;
            font-size: 14px;
            line-height: 1.5;
            margin-bottom: 15px;
        }

        .card-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .cooking-time {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 12px;
            color: #666;
        }

        .difficulty {
            padding: 4px 12px;
            border-radius: 15px;
            font-size: 11px;
            font-weight: 500;
            text-transform: uppercase;
        }

        .difficulty.easy {
            background: #d4edda;
            color: #155724;
        }

        .difficulty.medium {
            background: #fff3cd;
            color: #856404;
        }

        .difficulty.hard {
            background: #f8d7da;
            color: #721c24;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 80px 20px;
            color: #666;
        }

        .empty-icon {
            margin-bottom: 20px;
            color: #ddd;
        }

        .empty-state h3 {
            font-size: 24px;
            margin-bottom: 10px;
            color: #333;
        }

        .empty-state p {
            font-size: 16px;
            margin-bottom: 30px;
        }

        .explore-btn {
            display: inline-block;
            padding: 12px 30px;
            background: #667eea;
            color: white;
            text-decoration: none;
            border-radius: 25px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .explore-btn:hover {
            background: #5a6fd8;
            transform: translateY(-2px);
        }

        /* Add Favorite Button */
        .add-favorite-controls {
            display: flex;
            gap: 10px;
            align-items: center;
            flex-shrink: 0;
            margin-left: auto;
        }

        .add-favorite-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            background: #28a745;
            color: white;
            border: none;
            border-radius: 25px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 14px;
        }

        .add-favorite-btn:hover {
            background: #218838;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(40, 167, 69, 0.3);
        }

        .add-favorite-btn svg {
            width: 18px;
            height: 18px;
        }

        /* Modal Styles */
        .modal {
            display: none;
            position: fixed;
            z-index: 10000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(5px);
            padding-top: 50px;
        }

        .modal-content {
            background-color: #fefefe;
            margin: 5% auto;
            padding: 0;
            border-radius: 15px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
            animation: modalFadeIn 0.3s ease;
        }

        @@keyframes modalFadeIn {
            from {
                opacity: 0;
                transform: translateY(-50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 30px;
            border-bottom: 1px solid #e0e0e0;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 15px 15px 0 0;
        }

        .modal-header h2 {
            margin: 0;
            font-size: 24px;
        }

        .close-modal {
            color: white;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
            line-height: 20px;
            transition: all 0.3s ease;
        }

        .close-modal:hover {
            transform: scale(1.2);
            opacity: 0.8;
        }

        .modal-body {
            padding: 30px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
            color: #333;
        }

        .form-control {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 14px;
            transition: all 0.3s ease;
            box-sizing: border-box;
        }

        .form-control:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .recipe-search-result {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            margin-bottom: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .recipe-search-result:hover {
            border-color: #667eea;
            background: #f8f9ff;
            transform: translateX(5px);
        }

        .recipe-search-result img {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border-radius: 8px;
        }

        .recipe-search-result-info {
            flex: 1;
        }

        .recipe-search-result-info h4 {
            margin: 0 0 5px 0;
            font-size: 16px;
            color: #333;
        }

        .recipe-search-result-info p {
            margin: 0;
            font-size: 14px;
            color: #666;
        }

        .recipe-search-result-actions {
            display: flex;
            gap: 10px;
        }

        .btn-add-favorite {
            padding: 8px 16px;
            background: #28a745;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.3s ease;
        }

        .btn-add-favorite:hover {
            background: #218838;
        }

        .btn-add-favorite:disabled {
            background: #ccc;
            cursor: not-allowed;
            opacity: 0.6;
        }

        .form-group small a {
            color: #667eea;
            text-decoration: none;
        }

        .form-group small a:hover {
            text-decoration: underline;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .favorite-list-container {
                padding: 15px;
                padding-top: 150px;
            }

            .favorite-header {
                flex-direction: column;
                text-align: center;
                gap: 20px;
            }

            .header-content {
                flex-direction: column;
                gap: 15px;
            }

            .header-text h1 {
                font-size: 24px;
            }

            .filter-section {
                flex-direction: column;
                align-items: stretch;
            }

            .search-box {
                max-width: none;
            }

            .filter-controls {
                flex-direction: column;
                gap: 15px;
                align-items: stretch;
            }
            
            .add-favorite-controls {
                margin-left: 0;
                justify-content: center;
                width: 100%;
            }
            
            .add-favorite-btn {
                width: 100%;
                justify-content: center;
            }

            .filter-buttons {
                justify-content: center;
            }

            .sort-controls {
                justify-content: center;
            }

            .favorites-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }
        }
    </style>
}

@section Scripts {
    <script>
        // Enhanced Favorite List functionality with API integration
        document.addEventListener('DOMContentLoaded', function() {
            const filterButtons = document.querySelectorAll('.filter-btn');
            const searchInput = document.querySelector('.search-input');
            const sortSelect = document.getElementById('sortSelect');
            const favoritesGrid = document.querySelector('.favorites-grid');
            const emptyState = document.querySelector('.empty-state');
            const statNumber = document.querySelector('.stat-number');

            let allFavorites = [];
            let filteredFavorites = [];

            // Show loading state
            showLoading();

            // Load favorites from API
            loadFavorites();

            // Cache favorites in localStorage
            function cacheFavorites(favorites) {
                try {
                    localStorage.setItem('cachedFavorites', JSON.stringify({
                        data: favorites,
                        timestamp: new Date().toISOString()
                    }));
                    console.log('✅ Cached favorites to localStorage');
                } catch (e) {
                    console.warn('⚠️ Could not cache favorites:', e);
                }
            }
            
            // Get cached favorites from localStorage
            function getCachedFavorites() {
                try {
                    const cached = localStorage.getItem('cachedFavorites');
                    if (cached) {
                        const parsed = JSON.parse(cached);
                        // Cache is valid for 24 hours
                        const cacheAge = new Date() - new Date(parsed.timestamp);
                        const maxAge = 24 * 60 * 60 * 1000; // 24 hours
                        if (cacheAge < maxAge) {
                            console.log('✅ Found cached favorites in localStorage');
                            return parsed.data;
                        } else {
                            console.log('⚠️ Cached favorites expired');
                            localStorage.removeItem('cachedFavorites');
                        }
                    }
                } catch (e) {
                    console.warn('⚠️ Could not read cached favorites:', e);
                }
                return null;
            }
            
            // Load favorites from API
            async function loadFavorites() {
                try {
                    console.log('🔄 Loading favorites...');
                    const response = await fetch('/api/FavoriteApi', {
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        credentials: 'include'
                    });

                    console.log('📡 Response status:', response.status, response.statusText);

                    if (!response.ok) {
                        const errorText = await response.text();
                        console.error('❌ Failed to load favorites:', response.status, errorText);
                        
                        // Check if it's a Spoonacular limit error FIRST (before parsing JSON)
                        // This handles cases where error response might not be valid JSON
                        const isSpoonacularLimit = response.status === 500 || 
                                                  response.status === 503 || 
                                                  errorText.includes('Spoonacular') || 
                                                  errorText.includes('daily points limit') || 
                                                  errorText.includes('points limit') ||
                                                  errorText.includes('402');
                        
                        if (isSpoonacularLimit) {
                            console.warn('⚠️ Spoonacular API limit detected - trying cached favorites');
                            
                            // Try to load cached favorites
                            const cachedFavorites = getCachedFavorites();
                            if (cachedFavorites && cachedFavorites.length > 0) {
                                console.log(`✅ Loaded ${cachedFavorites.length} cached favorites`);
                                processFavoritesArray(cachedFavorites, true); // Pass isSpoonacularLimit = true
                                showNotification('⚠️ Đang hiển thị favorites từ cache. Giới hạn API Spoonacular đã đạt (50 points/ngày). Giới hạn sẽ reset sau 24 giờ.', 'warning', 8000);
                                return;
                            }
                            
                            // No cache available, show message
                            showEmptyStateWithMessage('⚠️ Giới hạn API Spoonacular đã đạt (50 points/ngày). Favorites có thể đã được lưu nhưng không thể hiển thị chi tiết. Bạn vẫn có thể thêm favorites mới bằng button "Thêm món yêu thích". Giới hạn sẽ reset sau 24 giờ.');
                            return;
                        }
                        
                        // For non-200 responses, try to parse as JSON to get favorites data
                        // Some APIs might return favorites even with error status
                        try {
                            const errorData = JSON.parse(errorText);
                            
                            // Check if error response contains favorites array
                            if (Array.isArray(errorData)) {
                                console.log('✅ Found favorites array in error response');
                                const favoritesArray = errorData;
                                processFavoritesArray(favoritesArray);
                                return;
                            }
                            
                            // Check for favorites in nested properties
                            const favoritesInError = errorData.favorites || errorData.data || errorData.items || errorData.results;
                            if (Array.isArray(favoritesInError) && favoritesInError.length > 0) {
                                console.log(`✅ Found ${favoritesInError.length} favorites in error response`);
                                processFavoritesArray(favoritesInError);
                                return;
                            }
                        } catch (parseError) {
                            console.warn('⚠️ Could not parse error response as JSON:', parseError);
                        }
                        
                        // If we can't parse or no favorites found, try cached favorites
                        const cachedFavorites = getCachedFavorites();
                        if (cachedFavorites && cachedFavorites.length > 0) {
                            console.log(`✅ Loaded ${cachedFavorites.length} cached favorites as fallback`);
                            processFavoritesArray(cachedFavorites);
                            showNotification('⚠️ Đang hiển thị favorites từ cache. Dữ liệu có thể không cập nhật.', 'info', 5000);
                            return;
                        }
                        
                        // If we can't parse or no favorites found, show empty state
                        console.warn('⚠️ No favorites found in error response, showing empty state');
                        showEmptyState();
                        return;
                    }

                    const result = await response.json();
                    console.log('📦 Raw favorites response:', result);
                    
                    // Handle both array and wrapped object formats
                    let favoritesArray = [];
                    let message = '';
                    let isSpoonacularLimit = false;
                    
                    if (Array.isArray(result)) {
                        favoritesArray = result;
                    } else if (result && typeof result === 'object') {
                        // Check if response has favorites array
                        favoritesArray = result.favorites || result.data || result.items || [];
                        
                        // Check if Spoonacular limit message
                        if (result.spoonacularLimit) {
                            isSpoonacularLimit = true;
                            message = result.message || 'Giới hạn API Spoonacular đã đạt. Favorites có thể đã được lưu nhưng không thể hiển thị chi tiết.';
                            console.warn('⚠️ Spoonacular API limit detected:', message);
                            
                            // If no favorites and Spoonacular limit, try cache
                            if (favoritesArray.length === 0) {
                                const cachedFavorites = getCachedFavorites();
                                if (cachedFavorites && cachedFavorites.length > 0) {
                                    console.log(`✅ Loaded ${cachedFavorites.length} cached favorites`);
                                    processFavoritesArray(cachedFavorites, true);
                                    showNotification('⚠️ Đang hiển thị favorites từ cache. Giới hạn API Spoonacular đã đạt (50 points/ngày). Giới hạn sẽ reset sau 24 giờ.', 'warning', 8000);
                                    return;
                                }
                                showEmptyStateWithMessage(message);
                                return;
                            }
                        } else if (result.message && favoritesArray.length === 0) {
                            // Show custom message if provided
                            message = result.message;
                            console.log('📋 Message from API:', message);
                            showEmptyStateWithMessage(message);
                            return;
                        }
                    }
                    
                    console.log('✅ Loaded favorites:', favoritesArray.length);
                    console.log('📋 Raw favorites array (first item):', favoritesArray.length > 0 ? favoritesArray[0] : 'empty');
                    console.log('📋 Spoonacular limit:', isSpoonacularLimit);
                    
                    if (favoritesArray.length === 0) {
                        console.log('⚠️ No favorites found - showing empty state');
                        showEmptyState();
                        return;
                    }
                    
                    // Cache favorites for future use (when Spoonacular limit occurs)
                    cacheFavorites(favoritesArray);
                    
                    // Process favorites array
                    processFavoritesArray(favoritesArray, isSpoonacularLimit);
                    
                } catch (error) {
                    console.error('❌ Error loading favorites:', error);
                    // Try to load cached favorites on error
                    const cachedFavorites = getCachedFavorites();
                    if (cachedFavorites && cachedFavorites.length > 0) {
                        console.log(`✅ Loaded ${cachedFavorites.length} cached favorites on error`);
                        processFavoritesArray(cachedFavorites);
                        showNotification('⚠️ Đang hiển thị favorites từ cache do lỗi kết nối.', 'info', 5000);
                    } else {
                        showEmptyState();
                    }
                }
            }
            
            // Process favorites array and render
            function processFavoritesArray(favoritesArray, isSpoonacularLimit = false) {
                // Show warning message if Spoonacular limit but still have favorites
                if (isSpoonacularLimit) {
                    console.warn('⚠️ Spoonacular limit warning - showing favorites with limited details');
                    showNotification('⚠️ Giới hạn API Spoonacular đã đạt (50 points/ngày). Một số chi tiết có thể không đầy đủ. Giới hạn sẽ reset sau 24 giờ.', 'warning', 8000);
                }
                
                // Map API response to UI format
                allFavorites = favoritesArray.map(fav => {
                    const recipeId = fav.recipeId || fav.recipe_id || fav.recipe?.id || '';
                    return {
                        id: fav.id || fav._id || fav.favoriteId || '',
                        recipeId: recipeId,
                        recipeName: fav.recipeName || fav.recipe?.title || fav.recipe?.name || (recipeId ? `Recipe #${recipeId}` : 'Recipe'),
                        recipeCategory: fav.recipeCategory || fav.recipe?.category || 'lunch',
                        rating: fav.rating || fav.recipe?.rating || 4.5,
                        cookingTime: fav.cookingTime || fav.recipe?.readyInMinutes || fav.recipe?.cookingTime || 30,
                        image: fav.image || fav.recipe?.image || fav.recipeImage || '',
                        addedAt: fav.addedAt || fav.createdAt || fav.dateAdded || new Date().toISOString(),
                        difficulty: fav.difficulty || fav.recipe?.difficulty || 'easy',
                        recipeDescription: fav.recipeDescription || fav.recipe?.description || fav.recipe?.summary || 'Món ăn ngon'
                    };
                });
                
                console.log('✅ Mapped favorites:', allFavorites.length);
                if (allFavorites.length > 0) {
                    console.log('📋 Sample favorite:', JSON.stringify(allFavorites[0], null, 2));
                    console.log('📋 All favorites recipeIds:', allFavorites.map(f => f.recipeId).join(', '));
                }
                
                // Check if we have any favorites with recipeId
                const favoritesWithRecipeId = allFavorites.filter(f => f.recipeId && f.recipeId !== '');
                console.log(`📊 Favorites with recipeId: ${favoritesWithRecipeId.length}/${allFavorites.length}`);
                
                if (allFavorites.length === 0) {
                    console.log('⚠️ No favorites to display - showing empty state');
                    showEmptyState();
                    return;
                }
                
                // Always render favorites first (even if only have recipeId)
                filteredFavorites = [...allFavorites];
                renderFavorites();
                updateStats();
                
                // Then try to fetch recipe details for favorites that only have recipeId
                // Skip if Spoonacular limit to avoid further API calls
                if (!isSpoonacularLimit && favoritesWithRecipeId.length > 0) {
                    console.log(`🔄 Attempting to fetch recipe details for ${favoritesWithRecipeId.length} favorites...`);
                    fetchRecipeDetailsForFavorites().then(() => {
                        console.log('✅ Recipe details fetch completed - re-rendering...');
                        // Re-render after fetching details
                        filteredFavorites = [...allFavorites];
                        renderFavorites();
                        updateStats();
                        // Update cache with new details
                        cacheFavorites(favoritesArray);
                    }).catch(error => {
                        console.warn('⚠️ Could not fetch recipe details, but favorites are still displayed:', error);
                    });
                } else if (isSpoonacularLimit) {
                    console.log('⚠️ Skipping recipe details fetch due to Spoonacular limit');
                } else {
                    console.log('⚠️ No recipeIds found in favorites - skipping recipe details fetch');
                }
            }

            // Fetch recipe details for favorites that only have recipeId
            async function fetchRecipeDetailsForFavorites() {
                // Find favorites that need recipe details (only have recipeId, no name/image)
                const favoritesNeedingDetails = allFavorites.filter(fav => 
                    fav.recipeId && (fav.recipeName.startsWith('Recipe #') || !fav.image)
                );
                
                if (favoritesNeedingDetails.length === 0) {
                    console.log('✅ All favorites already have details');
                    return;
                }
                
                console.log(`🔄 Fetching recipe details for ${favoritesNeedingDetails.length} favorites...`);
                
                try {
                    // Get unique recipe IDs and clean them (remove "Recipe #" prefix if present)
                    const recipeIds = [...new Set(favoritesNeedingDetails.map(f => {
                        let id = f.recipeId;
                        // Extract numeric part if ID contains non-numeric characters
                        const numericMatch = id.match(/\d+/);
                        if (numericMatch) {
                            return numericMatch[0];
                        }
                        return id;
                    }).filter(id => id && id !== ''))];
                    
                    if (recipeIds.length === 0) {
                        console.warn('⚠️ No valid recipe IDs to fetch');
                        return;
                    }
                    
                    console.log(`📤 Requesting recipe details for IDs: ${recipeIds.join(', ')}`);
                    
                    // Fetch recipe details from API
                    const idsParam = recipeIds.join(',');
                    const response = await fetch(`/api/MealPlansApi/recipes?ids=${encodeURIComponent(idsParam)}`, {
                        method: 'GET',
                        credentials: 'include'
                    });
                    
                    if (!response.ok) {
                        const errorText = await response.text();
                        console.warn(`⚠️ Failed to fetch recipe details: ${response.status} - ${errorText}`);
                        // Don't throw - just log and continue with basic info
                        return;
                    }
                    
                    const recipes = await response.json();
                    console.log(`✅ Fetched ${recipes?.length || 0} recipe details`);
                    
                    if (!recipes || recipes.length === 0) {
                        console.warn('⚠️ No recipes returned from API');
                        return;
                    }
                    
                    // Create a map of recipeId to recipe data (support both string and int IDs)
                    const recipeMap = new Map();
                    recipes.forEach(recipe => {
                        const recipeId = (recipe.id?.toString() || recipe.Id?.toString() || '').trim();
                        if (recipeId) {
                            recipeMap.set(recipeId, recipe);
                            // Also map by numeric part for easier matching
                            const numericMatch = recipeId.match(/\d+/);
                            if (numericMatch && numericMatch[0] !== recipeId) {
                                recipeMap.set(numericMatch[0], recipe);
                            }
                        }
                    });
                    
                    console.log(`📋 Recipe map keys: ${Array.from(recipeMap.keys()).join(', ')}`);
                    
                    // Update favorites with recipe details
                    let updatedCount = 0;
                    allFavorites.forEach(fav => {
                        if (!fav.recipeId) return;
                        
                        // Try to find recipe by ID (exact match or numeric part)
                        let recipe = recipeMap.get(fav.recipeId);
                        if (!recipe) {
                            const numericMatch = fav.recipeId.match(/\d+/);
                            if (numericMatch) {
                                recipe = recipeMap.get(numericMatch[0]);
                            }
                        }
                        
                        if (recipe) {
                            if (fav.recipeName.startsWith('Recipe #') || !fav.recipeName) {
                                fav.recipeName = recipe.title || recipe.Title || fav.recipeName;
                                updatedCount++;
                            }
                            if (!fav.image) {
                                fav.image = recipe.image || recipe.Image || fav.image;
                            }
                            if (!fav.cookingTime || fav.cookingTime === 30) {
                                fav.cookingTime = recipe.readyInMinutes || recipe.ReadyInMinutes || fav.cookingTime;
                            }
                            if (!fav.rating || fav.rating === 4.5) {
                                fav.rating = recipe.rating || recipe.Rating || fav.rating;
                            }
                            if (!fav.recipeDescription || fav.recipeDescription === 'Món ăn ngon') {
                                fav.recipeDescription = recipe.summary || recipe.Summary || recipe.description || recipe.Description || fav.recipeDescription;
                            }
                        } else {
                            console.warn(`⚠️ Recipe not found for ID: ${fav.recipeId}`);
                        }
                    });
                    
                    console.log(`✅ Updated ${updatedCount} favorites with recipe details`);
                    
                    // Re-render if we updated any favorites
                    if (updatedCount > 0) {
                        filteredFavorites = [...allFavorites];
                        renderFavorites();
                    }
                } catch (error) {
                    console.error('❌ Error fetching recipe details:', error);
                    // Don't throw - continue with basic info
                }
            }

            // Render favorites
            function renderFavorites() {
                console.log(`🎨 Rendering ${filteredFavorites.length} favorites...`);
                
                if (filteredFavorites.length === 0) {
                    console.log('⚠️ No favorites to render - showing empty state');
                    showEmptyState();
                    return;
                }

                favoritesGrid.style.display = 'grid';
                emptyState.style.display = 'none';
                
                console.log('✅ Rendering favorites grid with', filteredFavorites.length, 'items');

                favoritesGrid.innerHTML = filteredFavorites.map(fav => `
                    <div class="favorite-card" data-category="${fav.recipeCategory}" data-rating="${fav.rating}" data-time="${fav.cookingTime}" data-date="${fav.addedAt}" data-id="${fav.id}" data-recipe-id="${fav.recipeId}">
                        <div class="card-image">
                            <img src="${getRecipeImage(fav)}" alt="${escapeHtml(fav.recipeName)}" loading="lazy" onerror="this.onerror=null; this.src='data:image/svg+xml;base64,';">
                            <div class="card-overlay">
                                <button class="quick-action-btn" title="Xem chi tiết">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                </button>
                                <button class="quick-action-btn" title="Nấu ngay">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                                        <line x1="3" y1="6" x2="21" y2="6"></line>
                                        <path d="M16 10a4 4 0 0 1-8 0"></path>
                                    </svg>
                                </button>
                                <button class="quick-action-btn" title="Thêm vào danh sách mua sắm">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="9" cy="21" r="1"></circle>
                                        <circle cx="20" cy="21" r="1"></circle>
                                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                    </svg>
                                </button>
                                <button class="quick-action-btn remove-btn" title="Xóa khỏi yêu thích" data-favorite-id="${fav.id}">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3,6 5,6 21,6"></polyline>
                                        <path d="M19,6v14a2,2 0 0,1 -2,2H7a2,2 0 0,1 -2,-2V6m3,0V4a2,2 0 0,1 2,-2h4a2,2 0 0,1 2,2v2"></path>
                                    </svg>
                                </button>
                            </div>
                            <div class="favorite-badge">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2">
                                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                </svg>
                            </div>
                        </div>
                        <div class="card-content">
                            <div class="card-header">
                                <h3>${escapeHtml(fav.recipeName)}</h3>
                                <div class="rating">
                                    <span class="stars">${'★'.repeat(Math.floor(fav.rating))}${'☆'.repeat(5-Math.floor(fav.rating))}</span>
                                    <span class="rating-text">${fav.rating.toFixed(1)}</span>
                                </div>
                            </div>
                            <p class="card-description">${escapeHtml(fav.recipeDescription || 'Món ăn ngon')}</p>
                            <div class="card-meta">
                                <span class="cooking-time">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12,6 12,12 16,14"></polyline>
                                    </svg>
                                    ${fav.cookingTime} phút
                                </span>
                                <span class="difficulty ${fav.difficulty}">${getDifficultyText(fav.difficulty)}</span>
                            </div>
                        </div>
                    </div>
                `).join('');

                // Attach event listeners to newly created buttons
                attachEventListeners();
            }

            // Attach event listeners
            function attachEventListeners() {
                document.querySelectorAll('.quick-action-btn').forEach(btn => {
                    btn.addEventListener('click', async function(e) {
                        e.stopPropagation();
                        const title = this.getAttribute('title');
                        const card = this.closest('.favorite-card');
                        
                        if (title === 'Xem chi tiết') {
                            showRecipeDetail(card);
                        } else if (title === 'Nấu ngay') {
                            startCooking(card);
                        } else if (title === 'Thêm vào danh sách mua sắm') {
                            addToShoppingList(card);
                        } else if (title === 'Xóa khỏi yêu thích') {
                            const favoriteId = this.getAttribute('data-favorite-id');
                            await removeFromFavorites(favoriteId, card);
                        }
                    });
                });
            }

            // Filter by category
            filterButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const filter = this.getAttribute('data-filter');
                    
                    // Update active button
                    filterButtons.forEach(btn => btn.classList.remove('active'));
                    this.classList.add('active');
                    
                    // Filter cards
                    filterCards(filter);
                });
            });

            // Search functionality
            searchInput.addEventListener('input', function() {
                const searchTerm = this.value.toLowerCase();
                filterCards('all', searchTerm);
            });

            // Sort functionality
            sortSelect.addEventListener('change', function() {
                const sortBy = this.value;
                sortCards(sortBy);
            });

            // Filter cards function
            function filterCards(category, searchTerm = '') {
                filteredFavorites = allFavorites.filter(fav => {
                    const categoryMatch = category === 'all' || fav.recipeCategory === category;
                    const searchMatch = searchTerm === '' || 
                        fav.recipeName.toLowerCase().includes(searchTerm) || 
                        fav.recipeDescription.toLowerCase().includes(searchTerm);
                    
                    return categoryMatch && searchMatch;
                });
                
                renderFavorites();
                updateStats();
            }

            // Sort cards function
            function sortCards(sortBy) {
                filteredFavorites.sort((a, b) => {
                    switch(sortBy) {
                        case 'name':
                            return a.recipeName.localeCompare(b.recipeName);
                        case 'time':
                            return a.cookingTime - b.cookingTime;
                        case 'rating':
                            return b.rating - a.rating;
                        case 'date':
                            return new Date(b.addedAt) - new Date(a.addedAt);
                        default:
                            return 0;
                    }
                });
                
                renderFavorites();
            }

            // Action functions
            function showRecipeDetail(card) {
                const title = card.querySelector('h3').textContent;
                alert(`Xem chi tiết công thức: ${title}\n\nTính năng này sẽ hiển thị:\n- Nguyên liệu chi tiết\n- Các bước nấu ăn\n- Video hướng dẫn\n- Mẹo nấu ăn`);
            }

            function startCooking(card) {
                const title = card.querySelector('h3').textContent;
                const time = card.querySelector('.cooking-time').textContent;
                if (confirm(`Bắt đầu nấu: ${title}?\nThời gian: ${time}`)) {
                    alert(`Chúc bạn nấu ăn ngon miệng! 🍳\n\nTính năng này sẽ:\n- Hiển thị timer nấu ăn\n- Hướng dẫn từng bước\n- Nhắc nhở thời gian`);
                }
            }

            function addToShoppingList(card) {
                const title = card.querySelector('h3').textContent;
                if (confirm(`Thêm "${title}" vào danh sách mua sắm?`)) {
                    showNotification(`Đã thêm "${title}" vào danh sách mua sắm!`, 'success');
                }
            }

            async function removeFromFavorites(favoriteId, card) {
                const title = card.querySelector('h3').textContent;
                const recipeId = card.getAttribute('data-recipe-id') || card.getAttribute('data-id');
                
                if (!recipeId) {
                    console.error('❌ RecipeId not found in card');
                    showNotification('Không tìm thấy ID công thức. Vui lòng thử lại!', 'error');
                    return;
                }
                
                if (!confirm(`Bạn có chắc muốn xóa "${title}" khỏi danh sách yêu thích?`)) {
                    return;
                }

                try {
                    console.log(`🔄 Deleting favorite - RecipeId: ${recipeId}`);
                    const response = await fetch(`/api/FavoriteApi/recipe/${encodeURIComponent(recipeId)}`, {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        credentials: 'include'
                    });

                    if (!response.ok) {
                        const errorText = await response.text();
                        console.error('❌ Failed to delete favorite:', response.status, errorText);
                        throw new Error('Failed to remove favorite');
                    }

                    // Add removal animation
                    card.style.transition = 'all 0.3s ease';
                    card.style.transform = 'scale(0.8)';
                    card.style.opacity = '0';
                    
                    setTimeout(() => {
                        // Remove from arrays
                        allFavorites = allFavorites.filter(f => f.id !== favoriteId && f.recipeId !== recipeId);
                        filteredFavorites = filteredFavorites.filter(f => f.id !== favoriteId && f.recipeId !== recipeId);
                        
                        // Clear cache and update
                        localStorage.removeItem('cachedFavorites');
                        renderFavorites();
                        updateStats();
                    }, 300);
                    
                    showNotification(`Đã xóa "${title}" khỏi yêu thích!`, 'info');
                } catch (error) {
                    console.error('Error removing favorite:', error);
                    showNotification('Có lỗi xảy ra. Vui lòng thử lại!', 'error');
                }
            }

            function updateStats() {
                statNumber.textContent = filteredFavorites.length;
            }

            function showEmptyState() {
                console.log('📭 Showing empty state');
                emptyState.style.display = 'block';
                favoritesGrid.style.display = 'none';
                if (statNumber) {
                    statNumber.textContent = '0';
                }
            }

            function showEmptyStateWithMessage(message) {
                console.log('📭 Showing empty state with message:', message);
                emptyState.style.display = 'block';
                favoritesGrid.style.display = 'none';
                if (statNumber) {
                    statNumber.textContent = '0';
                }
                // Update empty state message
                const emptyStateP = emptyState.querySelector('p');
                if (emptyStateP) {
                    emptyStateP.textContent = message;
                }
            }

            function showSpoonacularLimitMessage(message) {
                // This function is kept for backward compatibility but may not be used
                // Instead, we show empty state which is more user-friendly
                showEmptyState();
            }

            // Add Favorite Modal Functions
            function openAddFavoriteModal() {
                console.log('🔄 Opening add favorite modal');
                const modal = document.getElementById('addFavoriteModal');
                if (modal) {
                    modal.style.display = 'block';
                    document.body.style.overflow = 'hidden';
                    // Hide header and nav when modal is open
                    hideHeaderAndNav();
                    // Focus on input
                    setTimeout(() => {
                        const input = document.getElementById('recipeIdInput');
                        if (input) input.focus();
                    }, 100);
                }
            }

            function closeAddFavoriteModal() {
                console.log('🔄 Closing add favorite modal');
                const modal = document.getElementById('addFavoriteModal');
                if (modal) {
                    modal.style.display = 'none';
                    document.body.style.overflow = '';
                    // Show header and nav when modal is closed
                    showHeaderAndNav();
                    // Clear input and error
                    const input = document.getElementById('recipeIdInput');
                    const errorDiv = document.getElementById('recipeIdError');
                    if (input) input.value = '';
                    if (errorDiv) {
                        errorDiv.style.display = 'none';
                        errorDiv.innerHTML = '';
                    }
                }
            }

            function hideHeaderAndNav() {
                const header = document.querySelector('header');
                const nav = document.querySelector('nav');
                if (header) header.style.display = 'none';
                if (nav) nav.style.display = 'none';
            }

            function showHeaderAndNav() {
                const header = document.querySelector('header');
                const nav = document.querySelector('nav');
                if (header) header.style.display = '';
                if (nav) nav.style.display = '';
            }

            // Close modal when clicking outside
            window.onclick = function(event) {
                const modal = document.getElementById('addFavoriteModal');
                if (event.target == modal) {
                    closeAddFavoriteModal();
                }
            }

            // Allow Enter key to submit
            const recipeIdInput = document.getElementById('recipeIdInput');
            if (recipeIdInput) {
                recipeIdInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        addFavoriteByRecipeId();
                    }
                });
            }

            async function addFavoriteByRecipeId() {
                const input = document.getElementById('recipeIdInput');
                const errorDiv = document.getElementById('recipeIdError');
                
                if (!input) {
                    console.error('❌ Recipe ID input not found');
                    return;
                }

                const recipeId = input.value.trim();
                
                if (!recipeId || recipeId === '') {
                    if (errorDiv) {
                        errorDiv.style.display = 'block';
                        errorDiv.innerHTML = '<p>⚠️ Vui lòng nhập Recipe ID</p>';
                    }
                    input.focus();
                    return;
                }

                // Clear previous error
                if (errorDiv) {
                    errorDiv.style.display = 'none';
                    errorDiv.innerHTML = '';
                }

                console.log(`🔄 Adding favorite by RecipeId: ${recipeId}`);
                
                try {
                    // Disable button while processing
                    const submitBtn = document.querySelector('.btn-add-favorite:last-child');
                    const originalText = submitBtn ? submitBtn.textContent : '';
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.textContent = 'Đang thêm...';
                    }

                    const response = await fetch('/api/FavoriteApi', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ recipeId: recipeId }),
                        credentials: 'include'
                    });

                    if (!response.ok) {
                        const errorText = await response.text();
                        console.error('❌ Failed to add favorite:', response.status, errorText);
                        let errorMessage = 'Failed to add favorite';
                        try {
                            const errorData = JSON.parse(errorText);
                            errorMessage = errorData.message || errorData.error || errorMessage;
                        } catch {
                            errorMessage = errorText.substring(0, 100);
                        }
                        throw new Error(errorMessage);
                    }

                    const favorite = await response.json();
                    console.log('✅ Added favorite:', favorite);

                    showNotification(`Đã thêm Recipe ID "${recipeId}" vào yêu thích!`, 'success');
                    
                    // Clear input
                    input.value = '';
                    
                    // Reload favorites
                    await loadFavorites();
                    
                    // Close modal after a short delay
                    setTimeout(() => {
                        closeAddFavoriteModal();
                    }, 1500);

                } catch (error) {
                    console.error('❌ Error adding favorite:', error);
                    if (errorDiv) {
                        errorDiv.style.display = 'block';
                        errorDiv.innerHTML = `<p>⚠️ Có lỗi xảy ra: ${escapeHtml(error.message)}</p>`;
                    }
                    showNotification(`Có lỗi xảy ra: ${error.message}`, 'error');
                } finally {
                    // Re-enable button
                    const submitBtn = document.querySelector('.btn-add-favorite:last-child');
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.textContent = 'Thêm vào yêu thích';
                    }
                }
            }

            function getDifficultyText(difficulty) {
                switch(difficulty) {
                    case 'easy': return 'Dễ';
                    case 'medium': return 'Trung bình';
                    case 'hard': return 'Khó';
                    default: return 'Dễ';
                }
            }

            function getRecipeImage(fav) {
                // If recipe has an image, use it
                if (fav.image && fav.image.trim() !== '') {
                    return fav.image;
                }
                if (fav.recipeImage && fav.recipeImage.trim() !== '') {
                    return fav.recipeImage;
                }
                
                // Otherwise, use beautiful Unsplash food images based on category
                const foodImages = {
                    'breakfast': 'https://images.unsplash.com/photo-1533089860892-a7c6f0a88666?w=400&h=300&fit=crop',
                    'lunch': 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=400&h=300&fit=crop',
                    'dinner': 'https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=400&h=300&fit=crop',
                    'snack': 'https://images.unsplash.com/photo-1488477181946-6428a0291777?w=400&h=300&fit=crop',
                    'default': 'data:image/svg+xml;base64,'
                };
                
                return foodImages[fav.recipeCategory] || foodImages.default;
            }
            
            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            function showLoading() {
                favoritesGrid.innerHTML = `
                    <div style="grid-column: 1/-1; text-align: center; padding: 60px 20px;">
                        <div class="loading-spinner" style="display: inline-block; width: 50px; height: 50px; border: 5px solid #f3f3f3; border-top: 5px solid #667eea; border-radius: 50%; animation: spin 1s linear infinite;"></div>
                        <p style="margin-top: 20px; color: #666; font-size: 16px;">Đang tải danh sách yêu thích...</p>
                    </div>
                `;
                // Add keyframes for spinner
                if (!document.getElementById('spinner-keyframes')) {
                    const style = document.createElement('style');
                    style.id = 'spinner-keyframes';
                    style.innerHTML = `
                        @@keyframes spin {
                            0% { transform: rotate(0deg); }
                            100% { transform: rotate(360deg); }
                        }
                    `;
                    document.head.appendChild(style);
                }
            }

            function showNotification(message, type = 'info', duration = 3000) {
                // Create notification element
                const notification = document.createElement('div');
                notification.className = `notification notification-${type}`;
                notification.textContent = message;
                
                // Style notification
                Object.assign(notification.style, {
                    position: 'fixed',
                    top: '100px',
                    right: '20px',
                    padding: '15px 20px',
                    borderRadius: '12px',
                    color: 'white',
                    fontWeight: '500',
                    zIndex: '10000',
                    boxShadow: '0 4px 20px rgba(0,0,0,0.15)',
                    transform: 'translateX(400px)',
                    transition: 'transform 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55)'
                });
                
                // Set background color based on type
                const colors = {
                    success: '#4CAF50',
                    info: '#2196F3',
                    warning: '#FF9800',
                    error: '#F44336'
                };
                notification.style.backgroundColor = colors[type] || colors.info;
                
                // Add to page
                document.body.appendChild(notification);
                
                // Animate in
                setTimeout(() => {
                    notification.style.transform = 'translateX(0)';
                }, 100);
                
                // Remove after duration
                setTimeout(() => {
                    notification.style.transform = 'translateX(400px)';
                    setTimeout(() => {
                        if (notification.parentNode) {
                            document.body.removeChild(notification);
                        }
                    }, 300);
                }, duration);
            }
        });
    </script>
}