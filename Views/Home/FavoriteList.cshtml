            }

            .favorite-header {
                flex-direction: column;
                text-align: center;
                gap: 20px;
            }

            .header-content {
                flex-direction: column;
                gap: 15px;
            }

            .header-text h1 {
                font-size: 24px;
            }

            .filter-section {
                flex-direction: column;
                align-items: stretch;
            }

            .search-box {
                max-width: none;
            }

            .filter-buttons {
