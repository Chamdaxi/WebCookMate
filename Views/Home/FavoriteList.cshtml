@{
    ViewData["Title"] = "Danh sách yêu thích";
}

<div class="favorite-list-container">
    <!-- Header Section -->
    <div class="favorite-header">
        <div class="header-content">
            <div class="header-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
            </div>
            <div class="header-text">
                <h1>Danh sách yêu thích</h1>
                <p>Những món ăn bạn đã lưu</p>
            </div>
        </div>
        <div class="header-stats">
            <div class="stat-item">
                <span class="stat-number">12</span>
                <span class="stat-label">Món yêu thích</span>
            </div>
        </div>
    </div>

    <!-- Filter and Search Section -->
    <div class="filter-section">
        <div class="search-box">
            <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
            </svg>
            <input type="text" placeholder="Tìm kiếm món yêu thích..." class="search-input">
        </div>
        <div class="filter-buttons">
            <button class="filter-btn active" data-filter="all">Tất cả</button>
            <button class="filter-btn" data-filter="breakfast">Bữa sáng</button>
            <button class="filter-btn" data-filter="lunch">Bữa trưa</button>
            <button class="filter-btn" data-filter="dinner">Bữa tối</button>
            <button class="filter-btn" data-filter="snack">Đồ ăn nhẹ</button>
        </div>
    </div>

    <!-- Favorites Grid -->
    <div class="favorites-grid">
        <!-- Favorite Item 1 -->
        <div class="favorite-card" data-category="breakfast">
            <div class="card-image">
                <img src="https://images.unsplash.com/photo-1551218808-94e220e084d2?w=400&h=300&fit=crop" alt="Bánh mì nướng">
                <div class="card-overlay">
                    <button class="quick-action-btn" title="Xem chi tiết">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                    <button class="quick-action-btn" title="Nấu ngay">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <path d="M16 10a4 4 0 0 1-8 0"></path>
                        </svg>
                    </button>
                </div>
                <div class="favorite-badge">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                </div>
            </div>
            <div class="card-content">
                <div class="card-header">
                    <h3>Bánh mì nướng bơ</h3>
                    <div class="rating">
                        <span class="stars">★★★★★</span>
                        <span class="rating-text">4.8</span>
                    </div>
                </div>
                <p class="card-description">Bánh mì nướng giòn với bơ thơm ngon, hoàn hảo cho bữa sáng</p>
                <div class="card-meta">
                    <span class="cooking-time">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
